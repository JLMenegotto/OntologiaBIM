	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a catalogar: é.substituído.por"@pt
	Annotations: bim:Chave "d.catalogar.139"
	Annotations: bim:Ação "Ação de catalogar"@pt
	Annotations: bim:Definição "Declara a Identificação de um elemento que substituiu outro elemento. A declaração Declara o elemento novo."@pt
	Annotations: bim:Definición "Declara la identificación de un elemento que ha reemplazado a otro elemento. La Declara identifica el nuevo elemento."@es
	Annotations: bim:Definition "Declares the identification of an element that has replaced another element. The declaration identifies the new element."@en
	EquivalentTo: bim:é.substituída.por

