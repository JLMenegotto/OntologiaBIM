bim:Critério.Qualif.H10.I  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.H ;
     bim:é.pertencente.a    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.H10 ;
     bim:tema    "Infraestrutura de transportes" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Infraestrutura aeroportuária: engloba a construção, modernização e operação de instalações orientadas à redução de emissões e à eficiência energética. A infraestrutura deve favorecer a integração com sistemas de transporte intermodais de baixo carbono, promovendo eficiência logística e redução de emissões associadas ao transporte de mercadorias e passageiros e, quando possível, o uso de materiais reciclados e de baixo carbono, e deve cumprir os parâmetros de acessibilidade para as pessoas com deficiência (PcD). Os investimentos elegíveis podem incluir, mas não se restringem a: Critério.Qualif.H10.I.a, Critério.Qualif.H10.I.b, Critério.Qualif.H10.I.c, Critério.Qualif.H10.I.d" ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.H10 ;
     bim:é.qualificadora.de    bim:Sistemas.Portuários ;
     bim:é.qualificadora.de    bim:Sistemas.Transportes  .

bim:Critério.Qualif.H10.I.a  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.H ;
     bim:é.pertencente.a    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.H10 ;
     bim:tema    "Infraestrutura de transportes" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Fornecimento de energia renovável e ar pré-condicionado para aeronaves enquanto estão estacionadas, reduzindo o uso de motores auxiliares a combustível fóssil (Auxiliary Power Units)." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.H10 ;
     bim:é.qualificadora.de    bim:Sistemas.Portuários ;
     bim:é.qualificadora.de    bim:Sistemas.Transportes  .

bim:Critério.Qualif.H10.I.b  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.H ;
     bim:é.pertencente.a    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.H10 ;
