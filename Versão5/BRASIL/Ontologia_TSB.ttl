      bim:Definition  "Positive criteria contribute or substantially contribute to improvements to sustainability according to the Brazilian Sustainable Taxonomy (TSB)"@en ;
      bim:Natureza    "Taxonômicos"@pt ;
      bim:Espécie     "Sustentabilidade TSB"@pt ;
