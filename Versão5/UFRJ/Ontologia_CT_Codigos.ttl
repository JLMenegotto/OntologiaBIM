bim:Interruptor.Relé rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Interruptores ;
      rdfs:label  "Interruptor Relé"@pt ;
      bim:Definição   "Interruptor relé. Controlar circuitos elétricos de forma indireta, permitindo que uma corrente elétrica pequena acione ou desligue uma corrente maior. Atua como um comutador eletromecânico ou eletrônico, muito usado em automação residencial e industrial."@pt ;
      bim:Definición  "Interruptor de relé. Controlar los circuitos eléctricos indirectamente, permitiendo que una pequeña corriente eléctrica active o apague una corriente mayor. Actúa como un interruptor electromecánico o electrónico, ampliamente utilizado en la automatización doméstica e industrial."@es ;
      bim:Definition  "Relay switch. Controlling electrical circuits indirectly, allowing a small electric current to trigger or turn off a larger current. It acts as an electromechanical or electronic switch, widely used in home and industrial automation."@en ;
      bim:Natureza    "Insumos"@pt ;
      bim:Espécie     "Insumos Elétricos"@pt ;
      bim:Tema        "Interruptores"@pt ;
      bim:Disciplina  "Arquitetura"@pt ;
      bim:Chave       "Key-COD-738"@pt ;
      bim:CatRevit    "[ OST_LightingFixtures : OST_ElectricalConnector ]"   ;
      bim:ParRevit    "[ - ]"   ;
      bim:AtributoIfc "[ - ]"   ;
      bim:ClasseIfc   "[ IfcSwitchingDeviceRELAY ]"   ;
      bim:ABNT        "[ - ]"    .


