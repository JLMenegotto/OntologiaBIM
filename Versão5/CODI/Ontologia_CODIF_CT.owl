	Annotations: bim:Definição "Aparelho elétrico que tem como função principal armazenar alimentos em temperaturas abaixo do livre."@pt
	Annotations: bim:Definición "Dispositivo eléctrico cuya función principal es almacenar alimentos a temperaturas inferiores a la libre."@es
	Annotations: bim:Definition "Electrical device whose main function is to store food at temperatures below free."@en
	Annotations: bim:Natureza "Equipamentos"@pt
	Annotations: bim:Espécie "Eq Elétricos"@pt
	Annotations: bim:Tema "Eq Cozinha"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-442"
	Annotations: bim:CatRevit "[ OST_ElectricalEquipment ]"
	Annotations: bim:ClasseIfc "[ IfcElectricAppliance FREEZER ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Eq.Cozinha


