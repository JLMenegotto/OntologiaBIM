ObjectProperty: bim:p.drenar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.bacia.hidrográfica.escoamento
	SubPropertyOf: bim:p.drenar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a drenar: é.bacia.hidrográfica.escoamento"@pt
	Annotations: bim:Chave "d.drenar.102"
	Annotations: bim:Ação "Ação de drenar"@pt
	Annotations: bim:Definição "Declara a razão entre o volume de água escoado superficialmente e o volume de água de chuva. Coef = Vescoado / Vprecipitado, ou seja, valores próximos de 0 indicam alta infiltração."@pt
	Annotations: bim:Definición "Declara la proporción entre el volumen de escorrentía superficial y el volumen de agua de lluvia. Coef = Vescoado / Vprecipitate, es decir, valores cercanos a 0 indican una alta infiltración."@es
	Annotations: bim:Definition "Declares the ratio of the volume of surface water runoff to the volume of rainwater. Coef = Vescoado / Vprecipitate, i.e., values close to 0 indicate high infiltration."@en
	Annotations: bim:Código.ABNT "[ 3E.06 ]"
	EquivalentTo: bim:é.bacia.hidrográfica.runoff

