				<value>
					<xs:restriction base="xs:string">
						<xs:enumeration value="CT_JAN_120x120"/>
						<xs:enumeration value="CT_JAN_240x120"/>
						<xs:enumeration value="CT_JAN_125x60"/>
						<xs:enumeration value="CT_JAN_120x300"/>
