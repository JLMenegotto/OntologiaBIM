	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Luminárias


Class: bim:Luminária.Spot
	Annotations: rdfs:label "Luminária Spot"@pt
	Annotations: bim:Definição "Luminária considerada de área desprezível e que emite luz com intensidade uniforme."@pt
	Annotations: bim:Definición "Luminaria considerada de superficie insignificante y que emite luz con intensidad uniforme."@es
	Annotations: bim:Definition "Luminaire considered to have a negligible area and that emits light with uniform intensity."@en
