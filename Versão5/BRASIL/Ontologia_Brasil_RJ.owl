ObjectProperty: bim:p.trafegar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.rua.sentido
	SubPropertyOf: bim:p.trafegar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a trafegar: é.rua.sentido"@pt
	Annotations: bim:Chave "d.trafegar.102"
	Annotations: bim:Ação "Ação de trafegar"@pt
	Annotations: bim:Definição "Declara o sentido da rua (0 ou 2 para mão dupla; 1 para sentido seguindo a direção do vetor definido pelo eixo da via; -1 para indicar mão única no sentido contrário à linha do eixo de rua."@pt
	Annotations: bim:Definición "Declara la dirección de la calle (0 o 2 para bidireccional; 1 para dirección siguiendo la dirección del vector definido por el eje de la carretera; -1 para indicar sentido único en la dirección alejada de la línea del eje de la calle."@es
	Annotations: bim:Definition "Declares the direction of the street (0 or 2 for two-way; 1 for direction following the direction of the vector defined by the road axis; -1 to indicate one-way in the direction away from the street axis line."@en
	Annotations: bim:CatRevit "[ OST_Floors ]"
	Annotations: bim:ClasseIfc "[ IfcAlignment : IfcSlab : IfcCourse ]"
	Annotations: bim:Código.ABNT "[ 4U.30.10.02.38 ]"
	EquivalentTo: bim:é.viaduto.sentido

