<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS"
     xmlns:xs="http://www.w3.org/2001/XMLSchema"
     version="1.0">
	<info>
		<title>Arquivo IDS sincronizado com ontologia</title>
		<version>Esp. 1.0</version>
		<description>Especificação IDS do projeto CT da UFRJ</description>
		<author>jlmenegotto@poli.ufrj.br</author>
		<date>2026-11-18</date>
	</info>
	<specifications> 

		<!-- "Área mínima de quartos. Precisa ter pelo menos 1 quarto" -->
		<specification name="Req_Amb_01" ifcVersion="IFC4" identifier="Req_Amb_01" description="Área mínima de quartos. Precisa ter pelo menos 1 quarto">
			<applicability  minOccurs= "1"  maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.01.01</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attributecardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<xs:restriction base="xs:string">
						<xs:pattern value=".*Quarto*.*"/>
					</xs:restriction>
				</attribute>
				<property dataType="IFCAREAMEASURE" cardinality="required">
					<propertySet><simpleValue>Qto_SpaceBaseQuantities</simpleValue></propertySet>
					<baseName><simpleValue>NetFloorArea</simpleValue></baseName>
					<value>
						<xs:restriction base="xs:double">
							<xs:minInclusive value="10"/>
						</xs:restriction>
					</value>
				</property>
			</requirements>
		</specification>

		<!-- "Área mínima das salas. Precisa ter ao menos 1 sala." -->
		<specification name="Req_Amb_02" ifcVersion="IFC4" identifier="Req_Amb_02" description="Área mínima das salas. Precisa ter ao menos 1 sala.">
			<applicability  minOccurs= "1"  maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.01.07</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attributecardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<value><simpleValue>Sala</simpleValue></value>
				</attribute>
				<property dataType="IFCAREAMEASURE" cardinality="required">
					<propertySet><simpleValue>Qto_SpaceBaseQuantities</simpleValue></propertySet>
					<baseName><simpleValue>NetFloorArea</simpleValue></baseName>
					<value>
						<xs:restriction base="xs:double">
							<xs:minInclusive value="30"/>
						</xs:restriction>
					</value>
				</property>
			</requirements>
		</specification>

		<!-- "Área mínima do banheiro. Precisa ter ao menos1 banheiro." -->
		<specification name="Req_Amb_03" ifcVersion="IFC4" identifier="Req_Amb_03" description="Área mínima do banheiro. Precisa ter ao menos1 banheiro.">
			<applicability  minOccurs= "1"  maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.04.07</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attributecardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<value><simpleValue>Banheiro</simpleValue></value>
				</attribute>
				<property dataType="IFCAREAMEASURE" cardinality="required">
					<propertySet><simpleValue>Qto_SpaceBaseQuantities</simpleValue></propertySet>
					<baseName><simpleValue>NetFloorArea</simpleValue></baseName>
					<value>
						<xs:restriction base="xs:double">
							<xs:minInclusive value="3"/>
						</xs:restriction>
					</value>
				</property>
			</requirements>
		</specification>

		<!-- "Área mínima da cozinha. Precisa ter ao menos 1 cozinha." -->
		<specification name="Req_Amb_04" ifcVersion="IFC4" identifier="Req_Amb_04" description="Área mínima da cozinha. Precisa ter ao menos 1 cozinha.">
			<applicability  minOccurs= "1"  maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.01.25</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attributecardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<value><simpleValue>Cozinha</simpleValue></value>
				</attribute>
				<property dataType="IFCAREAMEASURE" cardinality="required">
					<propertySet><simpleValue>Qto_SpaceBaseQuantities</simpleValue></propertySet>
					<baseName><simpleValue>NetFloorArea</simpleValue></baseName>
					<value>
						<xs:restriction base="xs:double">
							<xs:minInclusive value="8"/>
						</xs:restriction>
					</value>
				</property>
			</requirements>
		</specification>
	</specifications>
</ids>
