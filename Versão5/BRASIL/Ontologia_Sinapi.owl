ObjectProperty: bim:é.circuito.elétrico.luz
	SubPropertyOf: bim:p.eletrificar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a eletrificar: é.circuito.elétrico.luz"@pt
	Annotations: bim:Chave "d.eletrificar.102"
	Annotations: bim:Ação "Ação de eletrificar"@pt
	Annotations: bim:Definição "Declara o ID de Revit ou GlobalId IFC ou identificador único de objeto. É um elemento de circuito elétrico de iluminação, para as lâmpadas (127 V ou 220 V). Separado dos circuitos de tomadas."@pt
	Annotations: bim:Definición "Declara el ID de Revit o IFC GlobalId o un identificador único de objeto. Es un elemento del circuito de iluminación eléctrica de las lámparas (127 V o 220 V). Separado de los circuitos de enchufes."@es
	Annotations: bim:Definition "Declares the Revit ID or IFC GlobalId or unique object identifier. It is an element of the electrical lighting circuit for the lamps (127 V or 220 V). Separate from socket circuits."@en
	Annotations: bim:CatRevit "[ OST_Wire : OST_ElectricalAnalyticalFeeder : OST_ElectricalAnalyticalTransformer : OST_ElectricalCircuit : OST_ElectricalCircuitNaming : OST_ElectricalCircuitTags : OST_ElectricalConnector : OST_ElectricalConnectorTags : OST_ElectricalDemandFactor : OST_ElectricalDemandFactorDefinitions : OST_ElectricalEquipment : OST_ElectricalEquipmentHiddenLines : OST_ElectricalEquipmentTags : OST_ElectricalFixtures : OST_ElectricalFixturesHiddenLines : OST_ElectricalFixtureTags : OST_ElectricalInternalCircuits_Obsolete : OST_ElectricalLoadCase : OST_ElectricalLoadClassifications : OST_ElectricalLoadSet : OST_ElectricalLoadZoneInstance : OST_ElectricalLoadZoneType : OST_ElectricalPowerSource : OST_ElectricalVoltage ]"
	Annotations: bim:ClasseIfc "[ IfcDistributionBoard : IfcDistributionBoardType : Pset_DistributionBoardTypeCommon : Pset_DistributionBoardOccurrence ]"
	EquivalentTo: bim:é.circuito.elétrico.emergência

