     bim:não.prejudicar    "Impacto mínimo sobre o habitat: implementar práticas que reduzam o impacto sobre os ecossistemas locais, como evitar produtos ligados ao desmatamento ou à destruição de habitats."  .

bim:NPS.Impacto.04  rdf:type  owl:NamedIndividual , bim:Critério.NPS ;
     bim:é.pertencente.a    bim:Taxonomia.TSB ;
     bim:é.aplicado.em    bim:Setor.TSB.Tur ;
     bim:é.não.prejudicar    bim:Atividade.Elegível.TUR01 ;
