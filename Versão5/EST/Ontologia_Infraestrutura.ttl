      rdfs:subClassOf  bim:Conexões.de.EE ;
      rdfs:label  "Ponto de Entrada"@pt ;
      bim:Definição   "Consultar Norma NBR 5410. Ponto em que uma linha externa penetra na edificação."@pt ;
      bim:Definición  "Consulte la norma NBR 5410. Punto en el que una línea externa penetra en el edificio."@es ;
      bim:Definition  "Consult NBR 5410 Standard. Point at which an external line penetrates the building."@en ;
      bim:Natureza    "Redes Urbanas"@pt ;
