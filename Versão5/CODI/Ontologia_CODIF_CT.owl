	SubPropertyOf: bim:p.navegar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a navegar: é.manga"@pt
	Annotations: bim:Chave "d.navegar.102"
	Annotations: bim:Ação "Ação de navegar"@pt
	Annotations: bim:Definição "Declara a Largura máxima do navio, geralmente medida na parte mais larga do casco. Sinónimo de boca."@pt
	Annotations: bim:Definición "Declara el Ancho máximo del navio, generalmente medida en la parte más ancha del casco. Sinónimo de boca."@es
	Annotations: bim:Definition "Declares the maximum width of the ship, usually measured at the widest part of the hull. Synonym for mouth."@en
	EquivalentTo: bim:é.boca

