     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E10.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
