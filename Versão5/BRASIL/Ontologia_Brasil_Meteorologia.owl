ObjectProperty: bim:é.norte.do.projeto
	SubPropertyOf: bim:p.orientar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a orientar: é.norte.do.projeto"@pt
	Annotations: bim:Chave "d.orientar.112"
	Annotations: bim:Ação "Ação de orientar"@pt
	Annotations: bim:Definição "Declara o ângulo do Norte do Projeto. É a orientação ortogonal de modelagem, normalmente posicionado considerando a rua de acesso ou fachada principal."@pt
	Annotations: bim:Definición "Declara el ángulo del norte del proyecto. Es la orientación ortogonal del modelado, generalmente posicionada tomando en cuenta la calle de acceso o la fachada principal."@es
	Annotations: bim:Definition "Declares the North angle of the Project. It is the orthogonal orientation of modeling, usually positioned by the street or facades."@en
	Characteristics: Functional
	EquivalentTo: bim:é.norte.projetual

