                    bim:Chave               "d.esgotar.114" ;
                    bim:Ação                "Ação de esgotar" ;
                    bim:Definição           "Declara que o objeto é posicionado a jusante de outro objeto (no sentido do fluxo). Propriedade pensada para ordenar elementos de desagues e tubulações. "@pt ;
                    bim:Definición          "Declara que el objeto está situado aguas abajo de otro objeto (en la dirección del flujo). Propiedad diseñada para ordenar elementos de caudales y tuberías."@es ;bim:Definition          "Declares that the object is positioned downstream of another object (in the direction of the flow). Property designed to order elements of flows and pipes."@en ;
                    rdf:type                owl:TransitiveProperty ;
                    rdf:type                owl:AsymmetricProperty ;
                    owl:inverseOf           bim:é.a.montante.de  .


