bim:Esquema.TI rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Conexões.de.EE ;
      rdfs:label  "Esquema TI"@pt ;
      bim:Definição   "Consultar Norma NBR 5410. Todas as partes vivas são isoladas da terra ou um ponto da alimentação é aterrado através de impedância. As massas da instalação são aterradas."@pt ;
      bim:Definición  "Consulte la norma NBR 5410. Todas las partes vivas están aisladas de la tierra o un punto de alimentación está conectado a tierra mediante impedancia. Las masas de la instalación están conectadas a tierra."@es ;
      bim:Definition  "Consult NBR 5410 Standard. All living parts are isolated from the earth or a feed point is grounded via impedance. The masses of the installation are grounded."@en ;
      bim:Natureza    "Redes Urbanas"@pt ;
      bim:Espécie     "Redes Elétricas"@pt ;
      bim:Tema        "Conexões de EE"@pt ;
      bim:Disciplina  "Interdisciplinar"@pt ;
      bim:Chave       "Key-INFRA-372"@pt ;
      bim:CatRevit    "[ OST_ElecDistributionSys ]"   ;
      bim:ClasseIfc   "[ IfcDistributionSystemLIGHTING ]"    .


