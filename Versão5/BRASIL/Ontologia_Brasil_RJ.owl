ObjectProperty: bim:é.leito.de.internação.em.berçário
	SubPropertyOf: bim:p.hospitalizar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a hospitalizar: é.leito.de.internação.em.berçário"@pt
	Annotations: bim:Chave "d.hospitalizar.116"
	Annotations: bim:Ação "Ação de hospitalizar"@pt
	Annotations: bim:Definição "Declara o ID de Revit ou GlobalId IFC ou identificador único de objeto. É um berço para recem nascido (RN) prematuro ou com patologia. Conta como internação. Parâmetro da Secretaria Municipal de Saúde do Rio de Janeiro."@pt
	Annotations: bim:Definición "Declara el ID de Revit o IFC GlobalId o un identificador único de objeto. Es una cuna para recién nacidos prematuros (NB) o para personas con patología. Cuenta como hospitalización. Parámetro del Departamento de Sanidad Municipal de Río de Janeiro."@es
	Annotations: bim:Definition "Declares the Revit ID or IFC GlobalId or unique object identifier. It is a crib for premature newborns (NB) or those with pathology. It counts as hospitalization. Parameter of the Municipal Health Department of Rio de Janeiro."@en
	Annotations: bim:CatRevit "[ OST_MedicalEquipment :  OST_NurseCallDevices : OST_Furnitures ]"
	Annotations: bim:ClasseIfc "[ IfcFurniture : IfcMedicalDevice ]"
	Annotations: bim:Código.ABNT "[ 2C.68.34.02.02 ]"
	EquivalentTo: bim:é.leito.hospitalar.de.internação

