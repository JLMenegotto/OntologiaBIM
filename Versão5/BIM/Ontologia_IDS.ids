	<specifications> 

		<!-- "Requisito de área obrigatória para os ambientes" -->
		<specification ifcVersion="IFC4" identifier="Req_Amb_01" description="Requisito de área obrigatória para os ambientes">
			<applicability  minOccurs= "1"  maxOccurs= "3">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
			</applicability>
			<requirements  cardinality= "required">
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.01.01</simpleValue></value>
				</classification>
				<attribute>
					<name><simpleValue>LongName</simpleValue></name>
					<xs:restriction base="xs:string">
						<xs:pattern value=".*Quarto*.*"/>
					</xs:restriction>
				</attribute>
			</requirements>
		</specification>

