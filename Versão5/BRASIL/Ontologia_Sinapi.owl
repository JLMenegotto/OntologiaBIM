ObjectProperty: bim:é.tição
	SubPropertyOf: bim:p.assentar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a assentar: é.tição"@pt
	Annotations: bim:Chave "d.assentar.109"
	Annotations: bim:Ação "Ação de assentar"@pt
