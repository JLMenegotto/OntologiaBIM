bim:Interruptor.Contactor rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Interruptores ;
      rdfs:label  "Interruptor Contactor"@pt ;
      bim:Definição   "Interruptor de contacto. Controla o acionamento de cargas elétricas de forma segura e eficiente em sistemas de alta potência. É um tipo de relé eletromecânico robusto, projetado para ligar e desligar motores, aquecedores, iluminação industrial e outros equipamentos pesados."@pt ;
      bim:Definición  "Interruptor de contacto. Controla el accionamiento de cargas eléctricas de forma segura y eficiente en sistemas de alta potencia. Es un tipo de relé electromecánico resistente que está diseñado para encender y apagar motores, calentadores, iluminación industrial y otros equipos pesados."@es ;
      bim:Definition  "Contact switch. Controls the drive of electrical loads safely and efficiently in high-power systems. It is a type of rugged electromechanical relay that is designed to turn motors, heaters, industrial lighting, and other heavy equipment on and off."@en ;
      bim:Natureza    "Insumos"@pt ;
      bim:Espécie     "Insumos Elétricos"@pt ;
      bim:Tema        "Interruptores"@pt ;
      bim:Disciplina  "Arquitetura"@pt ;
      bim:Chave       "Key-COD-737"@pt ;
      bim:CatRevit    "[ OST_LightingFixtures : OST_ElectricalConnector ]"   ;
      bim:ParRevit    "[ - ]"   ;
      bim:AtributoIfc "[ - ]"   ;
      bim:ClasseIfc   "[ IfcSwitchingDeviceCONTACTOR ]"   ;
      bim:ABNT        "[ - ]"    .


