Class: bim:Lâmpada.Iodetos.Metálicos
	Annotations: rdfs:label "Lâmpada Iodetos Metálicos"@pt
	Annotations: bim:Definição "Lâmpada de descarga na qual a maior parte da luz é emitida pela excitação de um haleto metálico. Usada em iluminação pública, industrial e esportiva."@pt
	Annotations: bim:Definición "Lámpara de descarga en la que la mayor parte de la luz se emite por la excitación de un halogenuro metálico.  Usada en iluminación pública, industrial y deportiva."@es
	Annotations: bim:Definition "A discharge lamp in which most of the light is emitted by the excitation of a metal halide. Used in public, industrial and sports lighting."@en
	Annotations: bim:Natureza "Luminotécnicos"@pt
	Annotations: bim:Espécie "Iluminação"@pt
	Annotations: bim:Tema "Lâmpadas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-600"
	Annotations: bim:CatRevit "[ OST_LightingDevices ]"
	Annotations: bim:ClasseIfc "[ IfcLampMETALHALIDE ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Lâmpadas


Class: bim:Lâmpada.Incandescente
	Annotations: rdfs:label "Lâmpada Incandescente"@pt
	Annotations: bim:Definição "Lâmpada que emite luz passando uma corrente elétrica através de um filamento de fio de tungstênio."@pt
	Annotations: bim:Definición "Una lámpara que emite luz haciendo pasar una corriente eléctrica a través de un filamento de alambre de tungsteno."@es
	Annotations: bim:Definition "A lamp that emits light by passing an electric current through a tungsten wire filament."@en
	Annotations: bim:Natureza "Luminotécnicos"@pt
	Annotations: bim:Espécie "Iluminação"@pt
	Annotations: bim:Tema "Lâmpadas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-601"
	Annotations: bim:CatRevit "[ OST_LightingDevices ]"
	Annotations: bim:ClasseIfc "[ IfcLampTUNGSTENFILAMENT ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Lâmpadas


Class: bim:Luminárias
	Annotations: rdfs:label "Luminárias"@pt
	SubClassOf: bim:Iluminação


Class: bim:Luminária
	Annotations: rdfs:label "Luminária"@pt
	Annotations: bim:Definição "Luminária é um recipiente concebido para o uso de uma ou mais lâmpadas."@pt
	Annotations: bim:Definición "Una luminaria es un recipiente diseñado para el uso de una o más lámparas."@es
	Annotations: bim:Definition "A light fixture is a container designed for the use of one or more lamps."@en
	Annotations: bim:Natureza "Luminotécnicos"@pt
	Annotations: bim:Espécie "Iluminação"@pt
	Annotations: bim:Tema "Luminárias"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-602"
	Annotations: bim:CatRevit "[ OST_LightingFixtures ]"
	Annotations: bim:ClasseIfc "[ IfcLightFixture ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Luminárias


Class: bim:Luminária.Direcional
	Annotations: rdfs:label "Luminária Direcional"@pt
	Annotations: bim:Definição "Luminária que se considera ter um comprimento ou área de superfície a partir da qual emite luz."@pt
	Annotations: bim:Definición "Una luminaria que se considera que tiene una longitud o área de superficie desde la cual emite luz."@es
	Annotations: bim:Definition "A luminaire that is considered to have a length or surface area from which it emits light."@en
