bim:Travertino rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Pedras ;
      rdfs:label  "Travertino"@pt ;
      bim:Definição   "Originado em precipitação de carbonato de cálcio em ambientes de águas termais e cavernas. Composta por calcita, aragonita e limonita. Porosa com veios marcantes, tons bege a marrom. Usada para valorizar revestimentos internos e externos, pisos, escadas, colunas."@pt ;
      bim:Definición  "Se originó en la precipitación de carbonato cálcico en manantiales termales y ambientes de cuevas. Compuesto por calcita, aragonita y limonita. Poroso con venas llamativas, tonos beige a marrones. Se utiliza para mejorar recubrimientos internos y exteriores, suelos, escaleras y columnas."@es ;
      bim:Definition  "Originated in precipitation of calcium carbonate in hot springs and cave environments. Composed of calcite, aragonite and limonite. Porous with striking veins, beige to brown tones. Used to enhance internal and external coatings, floors, stairs, columns."@en ;
      bim:Natureza    "Materialidades"@pt ;
      bim:Espécie     "Materiais Pétreos"@pt ;
      bim:Tema        "Pedras"@pt ;
      bim:Disciplina  "Interdisciplinar"@pt ;
      bim:Chave       "Key-MAT-172"@pt ;
      bim:CatRevit    "[ OST_Materials : OST_MaterialTags ]"   ;
      bim:ParRevit    "[ - ]"   ;
      bim:AtributoIfc "[ - ]"   ;
      bim:ClasseIfc   "[ IfcMaterial : IfcText : IfcLabel : IfcMaterialRelationship ]"   ;
      bim:ABNT        "[ 0M.20.10.01 ]"    .


