ObjectProperty: bim:é.tubulação.adutora
	SubPropertyOf: bim:p.abastecer
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a abastecer: é.tubulação.adutora"@pt
	Annotations: bim:Chave "d.abastecer.117"
	Annotations: bim:Ação "Ação de abastecer"@pt
	Annotations: bim:Definição "Declara a tubulação de grande diâmetro que transporta água do sistema de abastecimento desde os mananciais às estações de tratamento e reservatórios."@pt
	Annotations: bim:Definición "Declara la tubería de gran diámetro que transporta agua del sistema de abastecimiento desde los manantiales a las estaciones de tratamiento y a los depósitos."@es
	Annotations: bim:Definition "Declares the large-diameter pipeline that carries water from the supply system, from the sources to the treatment plants and reservoirs."@en
	Annotations: bim:CatRevit "[ OST_PipeSegments : OST_PipeFitting : OST_FlexPipeCurves : OST_PlaceHolderPipes ]"
	Annotations: bim:ClasseIfc "[ IfcPipeSegment : IfcPipeFitting ]"
	Characteristics: Irreflexive
	InverseOf: bim:é.abastecido.por

