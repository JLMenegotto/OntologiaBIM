      rdfs:subClassOf  bim:Proteções ;
      rdfs:label  "Contenção.Perfil"@pt ;
      bim:Definição   "Perfi L padrão ABNT, engastado na estrutura, com a função de proteção lateral da pista rodoviária."@pt ;
      bim:Definición  "Perfil estándar ABNT, empotrado en la estructura, con la función de protección lateral del carril de carretera."@es ;
      bim:Definition  "ABNT standard profile, embedded in the structure, with the function of lateral protection of the road lane."@en ;
      bim:Natureza    "Infraestruturais"@pt ;
      bim:Espécie     "Rodoviários"@pt ;
      bim:Tema        "Proteções"@pt ;
      bim:Disciplina  "Interdisciplinar"@pt ;
