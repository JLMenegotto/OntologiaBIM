bim:Ponte rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Obras.de.Arte.Especial ;
      rdfs:label  "Ponte"@pt ;
      bim:Definição   "Estrutura sujeita a ação de carga em movimento, com posicionamento variável, aqui chamada de carga móvel, utilizada para transpor um obstáculo natural (rio, córrego, vale etc.)."@pt ;
      bim:Definición  "Estructura sometida a la acción de la carga en movimiento, con posicionamiento variable, aquí llamada carga móvil, utilizada para superar un obstáculo natural (río, arroyo, valle, etc.)."@es ;
      bim:Definition  "Structure subject to the action of load in motion, with variable positioning, here called mobile load, used to overcome a natural obstacle (river, stream, valley, etc.)."@en ;
      bim:Natureza    "Infraestruturais"@pt ;
      bim:Espécie     "Rodoviários"@pt ;
      bim:Tema        "Obras de Arte Especial"@pt ;
      bim:Disciplina  "Interdisciplinar"@pt ;
      bim:Chave       "Key-INFRA-202"@pt ;
      bim:CatRevit    "[ OST_Mass ]"   ;
      bim:ClasseIfc   "[ IfcBridge ]"    .


