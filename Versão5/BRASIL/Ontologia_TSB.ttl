      rdfs:label  "Atividades"@pt  .


bim:Medida.Qualificada rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Atividades ;
      rdfs:label  "Medida Qualificada"@pt ;
      bim:Definição   "Medidas ou Atividades diretamente qualificadas que, por sua natureza, atendem à definição de contribuição substancial de acordo com o respectivo objetivo da taxonomia e não exigem nenhum requisito adicional. Em todos os casos, o impacto climático delas é tão baixo que atendem inequivocamente ao nível de ambição da taxonomia. Essa abordagem pode se aplicar a atividades inteiras ou a partes de atividades."@pt ;
      bim:Definición  "Medidas o actividades directamente calificadas que, por su naturaleza, cumplen la definición de contribución sustancial según el objetivo taxonomíco respectivo y que no requieran requisitos adicionales. En todos los casos, su impacto climático es tan bajo que cumplen inequívocamente el nivel de ambición de la taxonomía. Este enfoque puede aplicarse a actividades completas o a partes de ellas."@es ;
      bim:Definition  "Directly qualified measures or activities that by their nature meet the definition of substantial contribution according to the respective taxonomy objective and do not require any additional requirements. In all cases, their climate impact is so low that they unequivocally meet the taxonomy's level of ambition. This approach can apply to entire activities or to parts of activities."@en ;
      bim:Natureza    "Taxonômicos"@pt ;
      bim:Espécie     "Sustentabilidade TSB"@pt ;
      bim:Tema        "Atividades"@pt ;
      bim:Disciplina  "Ecologia"@pt ;
      bim:Chave       "Key-TSB-42"@pt  .


