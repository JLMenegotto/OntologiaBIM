     bim:não.prejudicar    "Redução de desperdício: minimizar o desperdício de alimentos e bebidas por meio do gerenciamento eficiente do estoque, controle de porções e reaproveitamento ou doação de excedentes."  .

bim:NPS.Resíduos.06  rdf:type  owl:NamedIndividual , bim:Critério.NPS ;
     bim:é.pertencente.a    bim:Taxonomia.TSB ;
     bim:é.aplicado.em    bim:Setor.TSB.Tur ;
