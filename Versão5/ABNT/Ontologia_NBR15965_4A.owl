DataProperty: bim:forro.paginado
	SubPropertyOf: bim:d.rebaixar
	range: rdfs:Literal or xsd:string
	Annotations: rdfs:label "Dado para rebaixar: forro.paginado -- Formatado como (rdfs:Literal or xsd:string)"@pt
	Annotations: bim:Chave "d.rebaixar.105"
	Annotations: bim:Ação "Ação de rebaixar"@pt
	Annotations: bim:Definição "Declara o ID de Revit ou GlobalId IFC ou identificador único de objeto. É um forro montado por placas."@pt
	Annotations: bim:Definición "Declara el ID de Revit o IFC GlobalId o un identificador único de objeto. Es un techo montado con placas."@es
	Annotations: bim:Definition "Declares the Revit ID or IFC GlobalId or unique object identifier. It is a ceiling mounted by plates."@en
	Annotations: bim:CatRevit "[ OST_Ceilings : OST_CeilingsFinish1 : OST_CeilingsFinish2 : OST_Parts ]"
	Annotations: bim:ClasseIfc "[ IfcCoveringCEILING ]"
	Annotations: bim:Código.ABNT "[ 3E.16.04.02 ]"

