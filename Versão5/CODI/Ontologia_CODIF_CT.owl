ObjectProperty: bim:p.investigar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.biossegurança.nb3
	SubPropertyOf: bim:p.investigar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a investigar: é.biossegurança.nb3"@pt
	Annotations: bim:Chave "d.investigar.111"
	Annotations: bim:Ação "Ação de investigar"@pt
	Annotations: bim:Definição "Declara que é um laboratório de biossegurança nível de segurança 3 ou de contenção. Destinado ao trabalho com agentes de risco biológico da classe 3, microrganismos que acarretam elevado risco ao pesquisador e baixo risco para a comunidade. Consultar ABNT NBR ISO 35001 – Gestão de Biorrisco para Laboratórios e Organizações Relacionadas."@pt
	Annotations: bim:Definición "Declara que es un laboratorio de bioseguridad nivel 3 o contención. Destinado a trabajar con agentes de riesgo biológico clase 3, microorganismos que suponen un alto riesgo para el investigador y un bajo riesgo para la comunidad. Consulte ABNT NBR ISO 35001 – Gestión de Bioriesgos para Laboratorios y Organizaciones Relacionadas."@es
	Annotations: bim:Definition "Declares that it is a biosafety laboratory security level 3 or containment. Intended for work with class 3 biological risk agents, microorganisms that pose a high risk to the researcher and a low risk to the community.  Consult ABNT NBR ISO 35001 – Biorisk Management for Laboratories and Related Organizations."@en
	Annotations: bim:CatRevit "[ OST_Rooms : OST_MEPSpaces : OST_MEPZone ]"
	Annotations: bim:ClasseIfc "[ IfcSpace : IfcOccupant ]"
	Annotations: bim:ABNT "[ 4A.58 ]"
	EquivalentTo: bim:é.doença.nb3

