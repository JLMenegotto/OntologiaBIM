     bim:código    "TIC2.A" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade deve atender a todos os seguintes critérios: A B C." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC02 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.TIC02.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.pertencente.a    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Atividades de prestação de serviços de informação (Software – Soluções digitais, modelação e análise de dados para fins ambientais)" ;
     bim:código    "TIC2.A" ;
     bim:contribuição.substancial.de    "Contribuir para a melhorar da conectividade, para a implementação de soluções relacionadas com a mitigação da mudança do clima (p.ex. tecnologias digitais para otimizar a eficiência das redes elétricas através de soluções fora da rede ou sistemas híbridos de produção de energia) ou para a adaptação à mudança do clima (p.ex. antenas e redes usadas em sistemas de alerta precoce para desastres climáticos)." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC02 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.TIC02.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.pertencente.a    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Atividades de prestação de serviços de informação (Software – Soluções digitais, modelação e análise de dados para fins ambientais)" ;
     bim:código    "TIC2.B" ;
     bim:contribuição.substancial.de    "Utilizar energia de fontes que atendam os critérios indicados pelo caderno CNAE D – Eletricidade e Gás." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC02 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.TIC02.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.pertencente.a    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Atividades de prestação de serviços de informação (Software – Soluções digitais, modelação e análise de dados para fins ambientais)" ;
     bim:código    "TIC2.C" ;
     bim:contribuição.substancial.de    "Utilizar soluções TIC predominantemente para o fornecimento de dados e análises que permitem a redução das emissões de GEE. " ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC02 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.TIC03  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.pertencente.a    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Telecomunicações" ;
     bim:código    "TIC3.A" ;
     bim:contribuição.substancial.de    "Para se qualificarem como contribuição substancial, os sistemas de telecomunicações devem atender a todos os seguintes critérios: A B" ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC03 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.TIC03.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.pertencente.a    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Telecomunicações" ;
     bim:código    "TIC3.A" ;
     bim:contribuição.substancial.de    "Quando uma solução/tecnologia alternativa já está disponível no mercado, a solução de TIC demonstra uma economia substancial de emissões de GEE durante o ciclo de vida em comparação com as melhores soluções  ou tecnologias alternativas disponíveis. As emissões de GEE e as emissões líquidas do ciclo de vida devem ser calculadas usando metodologias como: ISO 14067:2018 ou ISO 14064-2:2019. a. As reduções de emissões de GEE do ciclo de vida devem ser verificadas por um terceiro independente, que avalie de forma transparente os critérios padrão, incluindo os critérios de revisão crítica." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC03 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.TIC03.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.pertencente.a    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Telecomunicações" ;
     bim:código    "TIC3.B" ;
     bim:contribuição.substancial.de    "Utilizar dados exclusivamente para auxiliar na mitigação ou adaptação à mudança do clima." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.TIC03 ;
     bim:é.aplicado.em    bim:Sistemas.Informáticos  .

bim:Critério.Qualif.DA01  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.D ;
     bim:é.pertencente.a    bim:Setor.TSB.D ;
     bim:é.aplicado.em    bim:Objetivo.02 ;
     bim:tema    "Adaptação da geração de energia elétrica de origem hidráulica" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade ou medida deve demonstrar a redução do risco climático ou a melhoria da resiliência por meio de: 1) Para risco baixo ou moderado do ativo ou atividade: apresentação de estudo qualitativo e/ou quantitativo. 2)Para risco alto do ativo ou atividade: realização de avaliação de vulnerabilidade conforme o processo completo descrito na metodologia específica do Anexo A2. Os níveis de risco devem ser determinados conforme as seções 1.1 e 1.2 do Anexo A2." ;
     bim:é.qualificadora.de    bim:Med.Qualif.DA07  .

