ObjectProperty: bim:p.assentar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.cutelo
	SubPropertyOf: bim:p.assentar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a assentar: é.cutelo"@pt
	Annotations: bim:Chave "d.assentar.104"
	Annotations: bim:Ação "Ação de assentar"@pt
	Annotations: bim:Definição "Declara que a parede é assentada com o tijolo em pé. A espessura da parede é a menor dimensão do tijolo. Também chamada de 'Meia Vez'."@pt
	Annotations: bim:Definición "Declara que el muro está colocado con el ladrillo en pie. El grosor de la pared es la dimensión más pequeña del ladrillo. También llamada 'Meia Vez'."@es
	Annotations: bim:Definition "Declares that the wall is laid with the brick standing. The wall thickness is the smallest dimension of the brick. Also called 'Meia Vez'."@en
	Annotations: bim:CatRevit "[ OST_Walls : OST_WallCoreLayer : OST_WallsInsulation : OST_WallsSubstrate : OST_Parts ]"
	Annotations: bim:ClasseIfc "[ IfcWall ]"
	Annotations: bim:Código.ABNT "[ 3E.14.02.02 ]"
	EquivalentTo: bim:é.meia.vez

