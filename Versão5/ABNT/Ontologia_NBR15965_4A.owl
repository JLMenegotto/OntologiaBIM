ObjectProperty: bim:é.guia.bidirecional.axial
	SubPropertyOf: bim:p.suportar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a suportar: é.guia.bidirecional.axial"@pt
	Annotations: bim:Chave "d.suportar.116"
	Annotations: bim:Ação "Ação de suportar"@pt
	Annotations: bim:Definição "Declara que é uma guia bidirecional axial (GBA), para tubos de DN 2 a 54 polegadas, produzida em aço carbono para aopio de baixo coeficiente de atrito em superfície de aço inox revestido, impregnado ou tratado com PTFE, permite os movimentos axial e ascendente."@pt
	Annotations: bim:Definición "Declara que es una guía axial bidireccional (GBA), para tuberías de DN 2 a 54 pulgadas, producida en acero al carbono para obtener bajo coeficiente de fricción sobre una superficie de acero inoxidable recubierta, impregnada o tratada con PTFE, que permite movimientos axiales y ascendentes."@es
	Annotations: bim:Definition "Declares that it is an axial bidirectional guide (GBA), for pipes from DN 2 to 54 inches, produced in carbon steel for low coefficient of friction on a stainless steel surface coated, impregnated or treated with PTFE, allows axial and upward movements."@en
	Annotations: bim:CatRevit "[ OST_PlaceHolderPipes ]"
	Annotations: bim:ClasseIfc "[ IfcMember ]"
	EquivalentTo: bim:é.guia.de.tubo.gba

