ObjectProperty: bim:é.coeficiente.de.redução.de.ruido
	SubPropertyOf: bim:p.audibilizar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a audibilizar: é.coeficiente.de.redução.de.ruido"@pt
	Annotations: bim:Chave "d.audibilizar.112"
	Annotations: bim:Ação "Ação de audibilizar"@pt
