bim:Nota.C.01  rdf:type  owl:NamedIndividual , bim:Nota ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     owl:sameAs   bim:Nota.Sucata.Metálica ;
     bim:é.explicado.em    bim:Nota.Sucata.Metálica ;
     bim:tema    "Notas" ;
     bim:nota    "Para a aplicação desses critérios, as matérias-primas renováveis referem-se a biomassa, resíduos biológicos industriais ou resíduos biológicos municipais. As matérias-primas circulares referem-se a sucata metálica reciclada, assim como coprodutos industriais reaproveitados no processo siderúrgico, como escórias recicláveis e finos de minério."  .

bim:Nota.C.02  rdf:type  owl:NamedIndividual , bim:Nota ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     owl:sameAs   bim:Nota.Período.Máximo ;
     bim:é.explicado.em    bim:Nota.Período.Máximo ;
     bim:tema    "Notas" ;
     bim:nota    "O período máximo para a definição da linha de base é 1°de janeiro de 2028, e a metodologia para a definição da linha de base deve ser definida por terceira parte independente e aprovada pelo órgão regulador da TSB."  .

bim:Nota.C.03  rdf:type  owl:NamedIndividual , bim:Nota ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     owl:sameAs   bim:Nota.05 ;
     bim:é.explicado.em    bim:Nota.05 ;
     bim:tema    "Notas" ;
     bim:nota    "A obtenção do aço a reciclar pode ser comprovada através de apresentação de Nota Fiscal."  .

bim:Nota.C.04  rdf:type  owl:NamedIndividual , bim:Nota ;
     bim:é.dentro.de    bim:Caderno.C ;
