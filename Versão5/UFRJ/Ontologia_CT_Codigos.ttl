      bim:Definition  "A Heliport must be prepared to operate helicopters with airstrip infrastructure, hangars, fueling, departure lounge, air traffic control, maintenance, security and logistics."@en ;
      bim:Natureza    "Infraestruturais"@pt ;
      bim:Espécie     "Aeroportuários"@pt ;
      bim:Tema        "Aeródromos"@pt ;
