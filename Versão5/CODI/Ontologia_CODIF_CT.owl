	Annotations: rdfs:label "Medidor"@pt
	Annotations: bim:Definição "Medidor de vazão é um dispositivo usado para medir a vazão num sistema."@pt
	Annotations: bim:Definición "Un medidor de flujo es un dispositivo que se utiliza para medir el flujo en un sistema."@es
