ObjectProperty: bim:é.contêiner.compartilhado
	SubPropertyOf: bim:p.gestionar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a gestionar: é.contêiner.compartilhado"@pt
	Annotations: bim:Chave "d.gestionar.112"
	Annotations: bim:Ação "Ação de gestionar"@pt
	Annotations: bim:Definição "Declara que o contêiner de informação está compartilhado. Na passagem de um estado a outro se recomenda ter um processo de autorização. Conceito da NBR 19650-1."@pt
	Annotations: bim:Definición "Declara que el container de información está compartido. Al trasladarse de un estado a otro, se recomienda tener un proceso de autorización. Concepto de NBR 19650-1."@es
	Annotations: bim:Definition "Declares that the information container is shared. When moving from one state to another, it is recommended to have an authorization process. Concept of NBR 19650-1."@en
	EquivalentTo: bim:é.estado.compartilhado

