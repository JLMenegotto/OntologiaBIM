	Annotations: rdfs:label "Insumo.Armazenamento"@pt
	SubClassOf: bim:Insumos


Class: bim:Tanques
	Annotations: rdfs:label "Tanques"@pt
	SubClassOf: bim:Insumo.Armazenamento


Class: bim:Tanque
	Annotations: rdfs:label "Tanque"@pt
	Annotations: bim:Definição "Tanque é um reservatório ou um recipiente onde um fluido ou gás é armazenado para uso posterior."@pt
	Annotations: bim:Definición "Un tanque es un depósito o un recipiente donde se almacena un fluido o gas para su uso posterior."@es
	Annotations: bim:Definition "A tank is a reservoir or a container where a fluid or gas is stored for later use."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-768"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTank ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Reservatório.Aberto
	Annotations: rdfs:label "Reservatório Aberto"@pt
	Annotations: bim:Definição "Reservatório aberto para contenção de algum insumo."@pt
	Annotations: bim:Definición "Reserva abierta para contener algún insumo."@es
	Annotations: bim:Definition "Open reservoir for containment of some input."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-769"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankBASIN ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Reservatório.Fechado
	Annotations: rdfs:label "Reservatório Fechado"@pt
	Annotations: bim:Definição "Reservatório fechado utilizado para armazenar um fluido à pressão ambiente."@pt
	Annotations: bim:Definición "Reserva cerrada que se utiliza para almacenar algún insumo a presión ambiente."@es
	Annotations: bim:Definition "A closed reservoir used to store a fluid at room pressure."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-770"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankSTORAGE ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Tanque.de.Pressão
	Annotations: rdfs:label "Tanque de Pressão"@pt
	Annotations: bim:Definição "Armazenar fluidos (líquidos ou gases) sob pressão interna superior à pressão atmosférica. Usado em diversos setores industriais, prediais e hospitalares. Sua função varia conforme o tipo de fluido, aplicação e sistema envolvido."@pt
	Annotations: bim:Definición "Almacene fluidos (líquidos o gases) a una presión interna superior a la presión atmosférica. Utilizado en diversos sectores industriales, de la construcción y hospitalarios. Su función varía según el tipo de fluido, la aplicación y el sistema involucrado."@es
	Annotations: bim:Definition "Store fluids (liquids or gases) under internal pressure higher than atmospheric pressure. Used in various industrial, building and hospital sectors. Its function varies according to the type of fluid, application and system involved."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-771"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankBREAKPRESSURE ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Tanque.de.Expansão
	Annotations: rdfs:label "Tanque de Expansão"@pt
	Annotations: bim:Definição "Tanque em sistemas hidráulicos e térmicos fechados. Projetado para absorver variações de volume do fluido causadas por mudanças de temperatura. Ele protege o sistema contra sobrecarga de pressão, evitando danos a tubulações, válvulas e equipamentos."@pt
	Annotations: bim:Definición "Depósito en sistemas hidráulicos y térmicos cerrados. Diseñado para absorber las variaciones de volumen de fluido causadas por los cambios de temperatura. Protege el sistema de sobrecargas de presión, evitando daños a tuberías, válvulas y equipos."@es
	Annotations: bim:Definition "Tank in closed hydraulic and thermal systems. Designed to absorb fluid volume variations caused by temperature changes. It protects the system from pressure overload, preventing damage to pipes, valves, and equipment."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-772"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankEXPANSION ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Tanque.de.Expansão.e.Alimentação
	Annotations: rdfs:label "Tanque de Expansão e Alimentação"@pt
	Annotations: bim:Definição "Tanque em sistemas hidráulicos e térmicos fechados. Projetado para alimentar o sistema e absorver variações de volume do fluido causadas por mudanças de temperatura. Ele protege o sistema contra sobrecarga de pressão, evitando danos a tubulações, válvulas e equipamentos."@pt
	Annotations: bim:Definición "Depósito en sistemas hidráulicos y térmicos cerrados. Diseñado para alimentar el sistema y absorber las variaciones de volumen de fluido causadas por los cambios de temperatura. Protege el sistema de sobrecargas de presión, evitando daños a tuberías, válvulas y equipos."@es
	Annotations: bim:Definition "Tank in closed hydraulic and thermal systems. Designed to feed the system and absorb fluid volume variations caused by temperature changes. It protects the system from pressure overload, preventing damage to pipes, valves, and equipment."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-773"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankFEEDANDEXPANSION ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Bandeja.de.Retenção.de.Óleo
	Annotations: rdfs:label "Bandeja de Retenção de Óleo"@pt
	Annotations: bim:Definição "Contem vazamentos ou derramamentos de óleo em equipamentos industriais, elétricos ou mecânicos. Evita que o óleo contaminado se espalhe, protegendo o ambiente e facilitando a manutenção."@pt
	Annotations: bim:Definición "Contiene fugas o derrames de aceite en equipos industriales, eléctricos o mecánicos. Evita que el aceite contaminado se propague, protegiendo el medio ambiente y facilitando el mantenimiento."@es
	Annotations: bim:Definition "Contains oil leaks or spills in industrial, electrical, or mechanical equipment. It prevents contaminated oil from spreading, protecting the environment and facilitating maintenance."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-774"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankOILRETENTIONTRAY ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Vaso.de.Pressão
	Annotations: rdfs:label "Vaso de Pressão"@pt
	Annotations: bim:Definição "Recipiente fechado usado para armazenar fluidos ou gases a uma pressão diferente da pressão do ambiente."@pt
	Annotations: bim:Definición "Un recipiente sin abrir que se utiliza para almacenar fluidos o gases a una presión distinta a la presión ambiente."@es
	Annotations: bim:Definition "An unopened container used to store fluids or gases at a pressure other than ambient pressure."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumo Armazenamento"@pt
	Annotations: bim:Tema "Tanques"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-775"
	Annotations: bim:CatRevit "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"
	Annotations: bim:ClasseIfc "[ IfcTankPRESSUREVESSEL ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Tanques


Class: bim:Vaso.de.Contenção
	Annotations: rdfs:label "Vaso de Contenção"@pt
	Annotations: bim:Definição "Modelo de reservatório fechado."@pt
	Annotations: bim:Definición "Modelo de reservorio cerrado."@es
	Annotations: bim:Definition "Closed reservoir model."@en
	Annotations: bim:Natureza "Insumos"@pt
