                    rdfs:subPropertyOf      bim:d.trafegar ;
                    rdfs:range               [rdf:type rdfs:Datatype ; owl:unionOf ( rdfs:Literalxsd:string) ]  ;
                    rdfs:label              " [rdf:type rdfs:Datatype ; owl:unionOf ( Dado para trafegar: viaduto.nível -- Formatado como (rdfs:Literalxsd:string)) ] " ;
                    bim:Chave               "d.trafegar.104" ;
                    bim:Ação                "Ação de trafegar" ;
                    bim:Definição           "Declara o nível do viaduto em relação a outra via de tráfego. Atributos (layer ou z_order em sistemas GIS. 0 = Nível do solo; Valores 1, 2, 3... Níveis acima do solo;  Valores -1, -2, -3 níveis abaixo do solo."@pt ;
                    bim:Definición          "Declara el nivel del viaducto en relación con otro carril de tráfico. Atributos (capa o z_order en sistemas SIG. 0 = Nivel del suelo; Valores 1, 2, 3... Niveles elevados; Valores -1, -2, -3 niveles bajo tierra."@es ;bim:Definition          "Declares the level of the viaduct in relation to another traffic lane. Attributes (layer or z_order in GIS systems. 0 = Ground level; Values 1, 2, 3... Above-ground levels; Values -1, -2, -3 levels below ground."@en ;
                    bim:CatRevit            "[ OST_Floors ]" ;
                    bim:ClasseIfc           "[ IfcAlignment : IfcSlab : IfcCourse ]"  .


