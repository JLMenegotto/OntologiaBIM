	<specifications> 

		<!-- "Requisito obrigatório (required) de combate ao incêndio nas paredes." -->
		<specification name="Esp_Paredes_01" ifcVersion="IFC4X3_ADD2" identifier="PAR-01" description="Requisito obrigatório (required) de combate ao incêndio nas paredes.">
			<applicability  minOccurs= "0"  maxOccurs= "unbounded">
				<classification>
					<system><simpleValue>NBR-15965-0P</simpleValue></system>
					<value><simpleValue>0P.60.60.03</simpleValue></value>
				</classification>
			</applicability>
			<requirements  cardinality= "required">
				<entity>
					<name><simpleValue>IFCWALL</simpleValue></name>
				</entity>
				<attribute>
					<name><simpleValue>Name</simpleValue></name>
					<xs:restriction base="xs:string">
						<xs:pattern value=".*"PAR".*"/>
					</xs:restriction>
				</attribute>
			</requirements>
		</specification>

