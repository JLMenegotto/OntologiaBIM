Class: bim:Cota.Gabaritada
	Annotations: rdfs:label "Cota Gabaritada"@pt
	SubClassOf: bim:Elementos.Horizontais


Class: bim:Gabarito.Freático
	Annotations: rdfs:label "Gabarito Freático"@pt
	Annotations: bim:Definição "Gabarito que define o nível superior da zona saturada de água subterrânea ou lençol freático."@pt
	Annotations: bim:Definición "Plantilla que define el nivel superior de la zona saturada de aguas subterráneas o nivel freático."@es
	Annotations: bim:Definition "Template that defines the upper level of the saturated zone of groundwater or water table."@en
	Annotations: bim:Natureza "Espacialidades"@pt
	Annotations: bim:Espécie "Elementos Horizontais"@pt
	Annotations: bim:Tema "Cota Gabaritada"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-AMB-16"
	Annotations: bim:CatRevit "[ OST_Levels , OST_LevelHeads ]"
	Annotations: bim:ClasseIfc "[ IfcBuildingStorey ]"
	Annotations: bim:ABNT "[ 4A.07.10.07 ]"
	SubClassOf: bim:Cota.Gabaritada


Class: bim:Gabarito.Subterrâneo
	Annotations: rdfs:label "Gabarito Subterrâneo"@pt
	Annotations: bim:Definição "Gabarito de profundidade. Pode ser usado para definir a cota superior de um projeto subterrâneo, como linha de metrô ou instalações especiais urbanas. Usado como limite de referência de penetração em profundidade para novos projetos."@pt
	Annotations: bim:Definición "Plantilla de profundidad. Puede utilizarse para establecer la elevación superior de un proyecto subterráneo, como líneas de metro o instalaciones especiales urbanas. Se utiliza como límite de referencia de penetración en profundidad para proyectos nuevos."@es
	Annotations: bim:Definition "Depth template. It can be used to set the upper elevation of an underground project, such as subway line or urban special installations. Used as a reference limit of penetration at depth for new projects."@en
	Annotations: bim:Natureza "Espacialidades"@pt
	Annotations: bim:Espécie "Elementos Horizontais"@pt
	Annotations: bim:Tema "Cota Gabaritada"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-AMB-17"
	Annotations: bim:CatRevit "[ OST_Levels , OST_LevelHeads ]"
	Annotations: bim:ClasseIfc "[ IfcBuildingStorey ]"
	Annotations: bim:ABNT "[ 4A.07.10.07 ]"
	SubClassOf: bim:Cota.Gabaritada


Class: bim:Gabarito.Aéreo
	Annotations: rdfs:label "Gabarito Aéreo"@pt
	Annotations: bim:Definição "Gabarito de altura permitida para realizar voos segurança com UAS (drones). Estabelecido pela ANAC (Agência Nacional de Aviação Civil). Especialmente em regiões próximas a aeroportos."@pt
	Annotations: bim:Definición "El medidor de altura permite realizar vuelos seguros con UAS (drones). Establecido por ANAC (Agencia Nacional de Aviación Civil). Especialmente en las regiones cercanas a los aeropuertos."@es
	Annotations: bim:Definition "Height gauge allowed to perform safe flights with UAS (drones). Established by ANAC (National Civil Aviation Agency). Especially in regions close to airports."@en
	Annotations: bim:Natureza "Espacialidades"@pt
	Annotations: bim:Espécie "Elementos Horizontais"@pt
	Annotations: bim:Tema "Cota Gabaritada"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-AMB-18"
	Annotations: bim:CatRevit "[ OST_Levels , OST_LevelHeads ]"
	Annotations: bim:ClasseIfc "[ IfcBuildingStorey ]"
	Annotations: bim:ABNT "[ 4A.07.10.07 ]"
	SubClassOf: bim:Cota.Gabaritada


Class: bim:Gabarito.Hídrico
	Annotations: rdfs:label "Gabarito Hídrico"@pt
	Annotations: bim:Definição "Gabarito que define os níveis variáveis de um corpo de água natural, como o mar ou crescentes máximas e mínimas de rios e lagoas. Referência para projetos em zonas litorais ou alagáveis."@pt
	Annotations: bim:Definición "Plantilla que define los niveles variables de un cuerpo de agua natural, como el mar o los máximos y mínimos ascendentes de ríos y estanques. Referencia para proyectos en zonas costeras o inundables."@es
	Annotations: bim:Definition "Template that defines the varying levels of a natural body of water, such as the sea or rising maximums and minimums of rivers and ponds. Reference for projects in coastal or floodable areas."@en
	Annotations: bim:Natureza "Espacialidades"@pt
	Annotations: bim:Espécie "Elementos Horizontais"@pt
	Annotations: bim:Tema "Cota Gabaritada"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-AMB-19"
	Annotations: bim:CatRevit "[ OST_Levels , OST_LevelHeads ]"
	Annotations: bim:ClasseIfc "[ IfcBuildingStorey ]"
	Annotations: bim:ABNT "[ 4A.07.10.07 ]"
	SubClassOf: bim:Cota.Gabaritada


Class: bim:Gabarito.Municipal
	Annotations: rdfs:label "Gabarito Municipal"@pt
	Annotations: bim:Definição "Gabarito de altura máxima permitida para as edificações em cada área urbana. Estabelecido por leis municipais de uso e ocupação do solo. Não pode ser ultrapassado pelo projeto."@pt
	Annotations: bim:Definición "El medidor de altura máxima permitía edificios en cada área urbana. Establecido por las leyes municipales de uso y ocupación del suelo. No puede ser superado por el proyecto."@es
	Annotations: bim:Definition "Maximum height gauge allowed for buildings in each urban area. Established by municipal laws of land use and occupation. It cannot be overtaken by the project."@en
	Annotations: bim:Natureza "Espacialidades"@pt
	Annotations: bim:Espécie "Elementos Horizontais"@pt
	Annotations: bim:Tema "Cota Gabaritada"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-AMB-20"
	Annotations: bim:CatRevit "[ OST_Levels , OST_LevelHeads ]"
	Annotations: bim:ClasseIfc "[ IfcBuildingStorey ]"
	Annotations: bim:ABNT "[ 4A.07.10.07 ]"
	SubClassOf: bim:Cota.Gabaritada


Class: bim:Elementos.de.Elevações
	Annotations: rdfs:label "Elementos.de.Elevações"@pt
