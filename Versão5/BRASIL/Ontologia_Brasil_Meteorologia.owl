ObjectProperty: bim:é.provedor.de.identidade
	SubPropertyOf: bim:p.autenticar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a autenticar: é.provedor.de.identidade"@pt
	Annotations: bim:Chave "d.autenticar.111"
	Annotations: bim:Ação "Ação de autenticar"@pt
	Annotations: bim:Definição "Declara um Provedor OpenID (OP), que é uma entidade que implementou os protocolos OpenID Connect e OAuth 2.0. Os OPs às vezes podem ser referidos pelo papel que desempenham, como: um serviço de token de segurança, um provedor de identidade (IDP) ou um servidor de autorização."@pt
	Annotations: bim:Definición "Declara un Proveedor OpenID (OP), que es una entidad que ha implementado los protocolos OpenID Connect y OAuth 2.0. A veces se puede referir a los OP por el papel que desempeñan, como: un servicio de token de seguridad, un proveedor de identidad (IDP) o un servidor de autorización."@es
	Annotations: bim:Definition "Declares an OpenID Provider (OP), which is an entity that has implemented the OpenID Connect and OAuth 2.0 protocols. OPs can sometimes be referred to by the role they play, such as: a security token service, an identity provider (IDP), or an authorization server."@en
	Characteristics: Functional
	EquivalentTo: bim:é.provedor.de.open.id

