ObjectProperty: bim:é.agrupada.a
	SubPropertyOf: bim:p.agrupar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a agrupar: é.agrupada.a"@pt
	Annotations: bim:Chave "d.agrupar.100"
	Annotations: bim:Ação "Ação de agrupar"@pt
	Annotations: bim:Definição "Declara que uma peça é agrupada a outros ou outros elementos. Pode não haver necessariamente uma relação funcional entre os elementos."@pt
	Annotations: bim:Definición "Declara que una parte está agrupada con otros elementos u otros. Puede que no haya necesariamente una relación funcional entre los elementos."@es
	Annotations: bim:Definition "Declares that a part is grouped with other or other elements. There may not necessarily be a functional relationship between the elements."@en
	EquivalentTo: bim:é.agrupado.a

