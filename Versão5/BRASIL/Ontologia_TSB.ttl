bim:Critério.Qualif.E02.F  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E02 ;
     bim:tema    "Construção, extensão e operação de redes de distribuição e reservação de água tratada (sistemas novos e existentes)" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Se o sistema de abastecimento de água ou distrito de medição e controle tiver atingido as metas finais estabelecidas pela Portaria MCID no 788/2024 (BRASIL. MCID, 2024) ou regulamentação que a substitua, ou seja, menos de 25% em relação ao volume total de água fornecida ou menos de 216 litros/ligação/dia, o sistema poderá reduzir as perdas de água em pelo menos 15% no sistema como um todo ou em um distrito de medição e controle, com base em uma comparação com os resultados de linha de base do próprio sistema, calculados a partir da média dos três anos anteriores." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E02 ;
     bim:é.qualificadora.de    bim:Sistemas.Hídricos  .

bim:Critério.Qualif.E03  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
