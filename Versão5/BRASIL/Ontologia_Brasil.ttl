bim:é.contêiner.em.andamento   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:p.gestionar ;
                    rdfs:domain             bim:BIM ;
                    rdfs:label              "Propriedade destinada a gestionar: é.contêiner.em.andamento" ;
                    bim:Chave               "d.gestionar.114" ;
                    bim:Ação                "Ação de gestionar" ;
                    bim:Definição           "Declara que o contêiner de informação está em andamento. Não precisa necessariamente estar visível a outros agentes, pois está em produção, mas para passar de estado precisa de processo de autorização. Conceito da NBR 19650-1."@pt ;
                    bim:Definición          "Declara que el container de información está en proceso. No necesariamente tiene que ser visible para otros agentes, ya que está en producción, pero para moverse de estado en estado necesita un proceso de autorización. Concepto de NBR 19650-1."@es ;bim:Definition          "Declares that the information container is in progress. It does not necessarily need to be visible to other agents, as it is in production, but to move from state to state it needs an authorization process. Concept of NBR 19650-1."@en ;
                    owl:equivalentProperty  bim:é.estado.andamento  .


bim:d.gestionar   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:BIMData  .


