	Annotations: bim:Definition "Declares the iluminance value Declares the amount of light that falls on a surface. The unit is Lux (1 Lm/m2) and must comply with the NBR ISO/CIE 8995-1 standard."@en
	Annotations: bim:CatRevit "[ OST_ElectricalDevices ]"
	Annotations: bim:ClasseIfc "[ IfcLamp ]"
	Annotations: bim:ABNT "[ 0P.70.30.07 ]"
	EquivalentTo: bim:é.nível.de.iluminamento.geral

