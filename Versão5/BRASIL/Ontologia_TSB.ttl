bim:Certificados  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "Certificações de conformidade para atividades de turísmo da TSB." ;
     bim:é.certificado.por    bim:Certificação.ABNT ;
     bim:é.certificado.por    bim:Certificação.AQUA ;
     bim:é.certificado.por    bim:Certificação.Blue ;
     bim:é.certificado.por    bim:Certificação.Biosphere ;
     bim:é.certificado.por    bim:Certificação.EarthCheck ;
     bim:é.certificado.por    bim:Certificação.Orgânico ;
