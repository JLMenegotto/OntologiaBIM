bim:Medida rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Atividades ;
      rdfs:label  "Medida"@pt ;
      bim:Definição   "Medida Adaptada torna a atividade econômica mais resiliente à mudança do clima. Por exemplo, a implementação ou uso de equipamentos de detecção de vazamentos (medida) por uma concessionária envolvida no abastecimento de água. Precisa cumprir critérios técnicos relevantes para poderem ser considerada alinhada (qualificada)."@pt ;
      bim:Definición  "La Medida Adaptada hace que la actividad económica sea más resiliente al cambio climático. Por ejemplo, la implementación o uso de equipos de detección de fugas (medición) por una empresa eléctrica involucrada en el suministro de agua. Debe cumplir criterios técnicos relevantes para considerarse alineado (cualificado)."@es ;
      bim:Definition  "Adapted Measure makes economic activity more resilient to climate change. For example, the implementation or use of leak detection (measure) equipment by a utility involved in water supply. It needs to meet relevant technical criteria in order to be considered aligned (qualified)."@en ;
      bim:Natureza    "Taxonômicos"@pt ;
      bim:Espécie     "Sustentabilidade TSB"@pt ;
      bim:Tema        "Atividades"@pt ;
      bim:Disciplina  "Ecologia"@pt ;
      bim:Chave       "Key-TSB-41"@pt  .


bim:Conceitos rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:BIM  .


