     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade deve atender ao critério A em conjunto com, no mínimo, um dos critérios técnicos entre B e C." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C03 ;
