     bim:tema    "Infraestrutura de transportes" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Equipamentos auxiliares às máquinas de manutenção de via, aos equipamentos de inspeção e aos trens autônomos/semiautônomos, contanto que sejam de zero emissões de GEE no uso." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.H10 ;
     bim:é.qualificadora.de    bim:Sistemas.Portuários ;
     bim:é.qualificadora.de    bim:Sistemas.Transportes  .

bim:Critério.Qualif.H10.J.d  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.H ;
     bim:é.pertencente.a    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.H10 ;
     bim:tema    "Infraestrutura de transportes" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para uma adequada execução dos serviços de obras em rodovias, é incentivado que sejam consideradas as seguintes premissas: 1) Promover a economia circular, quando aplicável, com o uso de materiais reciclados e de baixo carbono nas obras. 2) Garantir que os resíduos gerados durante a construção sejam adequadamente reutilizados ou reciclados. 3)Alcançar o nível “bom” na rodovia melhorada, conforme o Índice de Condição da Manutenção da Malha (ICM) publicado pelo Departamento Nacional de Infraestrutura de Transportes (DNIT)." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.H10 ;
     bim:é.qualificadora.de    bim:Sistemas.Portuários ;
     bim:é.qualificadora.de    bim:Sistemas.Transportes  .

bim:Critério.Qualif.H11  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
