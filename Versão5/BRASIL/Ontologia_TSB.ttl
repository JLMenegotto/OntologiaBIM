     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Os investimentos em sistemas de tratamento de esgoto existentes deve adotar o uso de tecnologias inovadoras, incluindo SbN, para o tratamento e gerenciamento de esgoto e do lodo gerado no processo." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E03 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E04  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Construção, extensão e operação de sistemas de coleta dos esgotos sanitários (sistemas novos e existentes)" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, os sistemas de coleta de esgotamento sanitário devem atender a pelo menos um dos seguintes critérios A B C." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E04 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E04.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E04 ;
     bim:tema    "Construção, extensão e operação de sistemas de coleta dos esgotos sanitários (sistemas novos e existentes)" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Sistemas de coleta de esgotamento sanitário: Promover a adequada coleta e transporte dos esgotos sanitários evitando vazamentos e transbordamentos, lançamento de esgoto não tratado em corpos d’água ou no subsolo e a presença de ligações irregulares." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E04 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E04.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E04 ;
     bim:tema    "Construção, extensão e operação de sistemas de coleta dos esgotos sanitários (sistemas novos e existentes)" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Sistemas de coleta de esgotamento sanitário: Promover a separação do esgoto domés co e industrial das águas pluviais para tratamento adequado por meio de sistema separador absoluto (mínima presença de águas pluviais), permi ndo um tratamento eficiente." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E04 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E04.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E04 ;
     bim:tema    "Construção, extensão e operação de sistemas de coleta dos esgotos sanitários (sistemas novos e existentes)" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Sistemas de coleta de esgotamento sanitário: Quando servirem a região com cobertura inferior a 90% da população com coleta e tratamento dos esgotos sanitários, expandir a provisão de coleta de esgotamento sanitário da população beneficiada, seja por meio de soluções centralizadas, descentralizadas ou individualizadas, visando a inclusão e o atendimento adequado mesmo em áreas de difícil acesso." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E04 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E05  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.explicado.em    bim:Nota.Agua.E05 ;
     bim:tema    "Produção e distribuição de água de reuso para fins não potáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade de produção e distribuição de água de reuso para fins não potáveis deve atender a pelo menos um dos seguintes critérios: A B C. Nota: O aproveitamento de água de chuva (por exemplo, por meio de sistemas de captação de águas pluviais) pode ser considerado como uma medida válida para reduzir a demanda por água potável ou por outras fontes convencionais. No entanto, não é considerada água de reuso no contexto do critério B, pois não se origina do tratamento de efluentes, mas sim de uma fonte pluvial direta." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E05 ;
     bim:é.qualificadora.de    bim:Sistemas.Hídricos  .

bim:Critério.Qualif.E05.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E05 ;
     bim:é.explicado.em    bim:Nota.Agua.E05 ;
     bim:tema    "Produção e distribuição de água de reuso para fins não potáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Produção e distribuição de água de reuso para fins não potáveis: Possibilitar a substituição de parte significativa do volume total de água previamente utilizado para os mesmos fins. Este critério se aplica principalmente a usuários finais, como indústrias ou outras instalações, que incorporem água de reuso em seus processos, a fim de reduzir a demanda por fontes convencionais." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E05 ;
     bim:é.qualificadora.de    bim:Sistemas.Hídricos  .

bim:Critério.Qualif.E05.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E05 ;
     bim:é.explicado.em    bim:Nota.Agua.E05 ;
     bim:tema    "Produção e distribuição de água de reuso para fins não potáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Produção e distribuição de água de reuso para fins não potáveis: Promover a produção de água de reuso a par r do volume de efluente tratado de esgoto sanitário, abrangendo tratamento complementar e sistema de distribuição para fins não potáveis, priorizando finalidades compativeis com o seu nível de tratamento. Este critério se aplica principalmente às ETE que gerem água de reuso." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E05 ;
     bim:é.qualificadora.de    bim:Sistemas.Hídricos  .

bim:Critério.Qualif.E05.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E05 ;
     bim:é.explicado.em    bim:Nota.Agua.E05 ;
     bim:tema    "Produção e distribuição de água de reuso para fins não potáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Substituir o uso de fontes convencionais por água de reuso de forma a resultar em redução comprovada das emissões de GEE associadas à captação, tratamento e distribuição de água potável, utilizando metodologia reconhecida, como o GHG Protocol ou outra equivalente." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E05 ;
     bim:é.qualificadora.de    bim:Sistemas.Hídricos  .

bim:Critério.Qualif.E06  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.explicado.em    bim:Nota.Agua.E06 ;
     bim:tema    "Digestão anaeróbia de lodo e esgoto" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade de digestão anaeróbia de lodo e esgoto deve atender a todos os seguintes critérios A B C. Nota: As atividades que facilitam o uso e a utilização do biogás, como aprimoramento, compressão ou armazenamento, são qualificadas se atenderem a esses critérios." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E06 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E06.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E06 ;
     bim:é.explicado.em    bim:Nota.Agua.E06 ;
     bim:tema    "Digestão anaeróbia de lodo e esgoto" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Implementação de um plano de manutenção e monitoramento, assegurando que os sistemas sejam operados com segurança e prevenindo emissões descontroladas de biogás e biometano em todas as situações." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E06 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E06.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E06 ;
     bim:é.explicado.em    bim:Nota.Agua.E06 ;
     bim:tema    "Digestão anaeróbia de lodo e esgoto" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Utilização do biogás produzido em atividades previstas nos termos desta taxonomia, tais como uso veicular, residencial, comercial, industrial, geração de energia (isto é, eletricidade e/ou calor), aplicação no setor químico, injeção em sistema de distribuição canalizada, entre outras atividades exercidas de maneira sustentável, desde que atendidos os parâmetros de qualidade estabelecidos pela regulamentação vigente." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E06 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E06.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E06 ;
     bim:é.explicado.em    bim:Nota.Agua.E06 ;
     bim:tema    "Digestão anaeróbia de lodo e esgoto" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Manejo adequado do lodo de esgoto gerado, o qual deve ser tratado, estabilizado ou higienizado para possibilitar, sempre que for tecnicamente viável e legalmente permitido, sua reutilização segura e sustentável para fins agrícolas ou industriais, incluindo processos de mineralização e recuperação de nutrientes, como nitrogênio e fósforo, o uso como condicionador de solo, composto orgânico, entre outras atividades exercidas de maneira sustentável, desde que atendida à legislação vigente." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E06 ;
     bim:é.qualificadora.de    bim:Sistemas.Sanitários  .

bim:Critério.Qualif.E07  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E07 ;
     bim:tema    "Coleta e transporte de resíduos não perigosos" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade de coleta de resíduos não perigosos deve atender a pelo menos um dos seguintes critérios A B C. Nota: Considerando a PNRS (Lei n°12.305/2010), que determina práticas de gestão ambientalmente adequadas de resíduos, as atividades de coleta e o transporte de resíduos não perigosos devem estar necessariamente vinculadas à disposição final adequada em aterros sanitários regulamentados e adequadamente gerenciados." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E07 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E07.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E07 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E07 ;
     bim:tema    "Coleta e transporte de resíduos não perigosos" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Coleta de resíduos não perigosos: Coleta e transporte: a infraestrutura para coleta e transporte de resíduos sólidos urbanos deve ser coletada e transportada separadamente, desde a fonte, para reu lização e/ou reciclagem ou outro tratamento cien fico e disposição final adequada dos rejeitos." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E07 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E07.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E07 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E07 ;
     bim:tema    "Coleta e transporte de resíduos não perigosos" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Coleta de resíduos não perigosos: Omização da coleta e do transporte de resíduos: as instalações e infraestrutura devem omizar a coleta e transporte dos resíduos sólidos urbanos como estações de transferência, armazenamento temporário e centros de distribuição que aumentem a eficiência das operações de gerenciamento de resíduos." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E07 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E07.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E07 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E07 ;
     bim:tema    "Coleta e transporte de resíduos não perigosos" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Coleta de resíduos não perigosos: Aprimoramentos logís cos: os investimentos em compactação, trituração e outras a vidades relacionadas devem promover o aumento da capacidade de transporte de resíduos para reciclagem ou outros locais de tratamento científico e disposição final adequada dos rejeitos." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E07 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E08  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E08 ;
     bim:tema    "Recuperação de materiais recicláveis ou reutilizáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade de recuperação de materiais de resíduos não perigosos deve atender a pelo menos um dos seguintes critérios A B. Nota: Serão priorizadas iniciativas alinhadas aos objetivos do Programa Diogo de Sant’Ana Pró-Catadoras e Pró-Catadores para a Reciclagem Popular (Decreto nº 11.414, 2023) , tais como: 1) o reconhecimento das catadoras e dos catadores como protagonistas do processo de reciclagem, 2) a contratação remunerada por serviços públicos, 3) capacitação técnica e profissionalização, 4) assessoria técnica contínua, e 5) inclusão socioeconômica na gestão de resíduos sólidos entre outros, conforme a legislação vigente." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E08 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E08.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E08 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E08 ;
     bim:tema    "Recuperação de materiais recicláveis ou reutilizáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Recuperação de materiais de resíduos não perigosos: A instalação de recuperação de materiais é qualificada quando: Critério.Qualif.E08.A.a , Critério.Qualif.E08.A.b ou Critério.Qualif.E08.A.c ." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E08 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E08.A.a  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E08 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E08 ;
     bim:tema    "Recuperação de materiais recicláveis ou reutilizáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Recuperação de materiais de resíduos não perigosos: Pelo menos 50%, em massa, dos resíduos são convertidos em matérias-primas secundárias adequadas para substituir materiais virgens nos processos de produção." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E08 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E08.A.b  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
     bim:é.pertencente.a    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.E08 ;
     bim:é.explicado.em    bim:Nota.Resíduos.E08 ;
     bim:tema    "Recuperação de materiais recicláveis ou reutilizáveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Recuperação de materiais de resíduos não perigosos: Os subprodutos têm um sistema de rastreabilidade para identificação e utilização." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.E08 ;
     bim:é.qualificadora.de    bim:Sistemas.Resíduos  .

bim:Critério.Qualif.E08.A.c  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.E ;
