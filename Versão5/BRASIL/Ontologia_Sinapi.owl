	range: xsd:boolean
	Annotations: rdfs:label "Dado para afirmar:  alucinação  Deve ser formatado como (xsd:boolean)"@pt
	Annotations: bim:Chave "d.afirmar.100"
	Annotations: bim:Ação "Ação de afirmar"@pt
	Annotations: bim:Definição "Declara que a resposta é alucinada (falsa ou sem sentido)."@pt
	Annotations: bim:Definición "Declara que la respuesta es alucinada (falsa o sin sentido)."@es
	Annotations: bim:Definition "Declares that the answer is hallucinated (false or nonsensical)."@en

