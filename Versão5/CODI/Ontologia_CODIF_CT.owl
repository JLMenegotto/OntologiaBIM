ObjectProperty: bim:é.identificador.ifc
	SubPropertyOf: bim:p.interoperar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a interoperar: é.identificador.ifc"@pt
	Annotations: bim:Chave "d.interoperar.116"
	Annotations: bim:Ação "Ação de interoperar"@pt
	Annotations: bim:Definição "Declara o atributo GlobalId de IFC. O IfcGloballyUniqueId é uma string codificada usada para identificar de forma única um objeto IFC é um GUID de 128 bits gerado automaticamente."@pt
	Annotations: bim:Definición "Declara el atributo GlobalId de IFC. El IfcGloballyUniqueId es una cadena codificada utilizada para identificar de forma única un objeto IFC y es un GUID generado automáticamente de 128 bits."@es
	Annotations: bim:Definition "Declares the GlobalId attribute of IFC. The IfcGloballyUniqueId is an encoded string used to uniquely identify an IFC object is an automatically generated 128-bit GUID."@en
	Annotations: bim:CatRevit "[ OST_PipeFitting ]"
	Annotations: bim:ClasseIfc "[ IfcPipeFitting ]"
	EquivalentTo: bim:é.ifc.identificador

