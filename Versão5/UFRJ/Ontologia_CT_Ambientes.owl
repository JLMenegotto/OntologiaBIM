ObjectProperty: bim:é.ods.17.19
	SubPropertyOf: bim:p.objetivar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a objetivar: é.ods.17.19"@pt
	Annotations: bim:Chave "d.objetivar.285"
	Annotations: bim:Ação "Ação de objetivar"@pt
	Annotations: bim:Definição "Declara que objetiva o ODS para Parcerias e Meios de Implementação. - 17.19 Apoiar desenvolvimento de indicadores de progresso."@pt
	Annotations: bim:Definición "Declara que su objetivo es el ODS para las Alianzas y los Medios de Implementación. - 17.19 Apoyar el desarrollo de indicadores de progreso."@es
	Annotations: bim:Definition "Declares that it aims at the SDG for Partnerships and Means of Implementation. - 17.19 Support development of progress indicators."@en
	EquivalentTo: bim:é.esg.governança.transparência

DataProperty: bim:d.objetivar
