ObjectProperty: bim:é.rua.nível
	SubPropertyOf: bim:p.trafegar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a trafegar: é.rua.nível"@pt
	Annotations: bim:Chave "d.trafegar.101"
	Annotations: bim:Ação "Ação de trafegar"@pt
	Annotations: bim:Definição "Declara o nível da rua em relação a outra via de tráfego. Atributos (layer ou z_order em sistemas GIS. 0 = Nível do solo; Valores 1, 2, 3... Níveis acima do solo;  Valores -1, -2, -3 níveis abaixo do solo."@pt
	Annotations: bim:Definición "Declara el nivel de la calle en relación con otro carril de tráfico. Atributos (capa o z_order en sistemas SIG. 0 = Nivel del suelo; Valores 1, 2, 3... Niveles elevados; Valores -1, -2, -3 niveles bajo tierra."@es
	Annotations: bim:Definition "Declares the level of the street in relation to another traffic lane. Attributes (layer or z_order in GIS systems. 0 = Ground level; Values 1, 2, 3... Above-ground levels; Values -1, -2, -3 levels below ground."@en
	Annotations: bim:CatRevit "[ OST_Floors ]"
	Annotations: bim:ClasseIfc "[ IfcAlignment : IfcSlab : IfcCourse ]"
	Annotations: bim:Código.ABNT "[ 4U.30.10.02.38 ]"
	EquivalentTo: bim:é.viaduto.nível

