     bim:é.qualificadora.de    bim:Sistemas.Paisagísticos  .

bim:Critério.Qualif.HA02.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.H ;
     bim:é.pertencente.a    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Objetivo.02 ;
     bim:é.dentro.de    bim:Critério.Qualif.HA02 ;
     bim:tema    "Serviços de reflorestamento e manejo de vegetação em áreas de infraestrutura de obras viárias" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Ser identificada como uma medida de redução do movimento de massa com potencial de afetar as redes de transporte existentes. Isso deve fazer parte de um plano abrangente de planejamento de infraestrutura resiliente, no qual as informações sobre o risco climático sejam incorporadas à tomada de decisões por organizações de planejamento de transporte e empresas contratantes. Quando apropriado, esses planos devem buscar objetivos de gerenciamento de risco de movimento de massa para reduzir os impactos adversos na infraestrutura de transporte." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.HA02 ;
     bim:é.qualificadora.de    bim:Sistemas.Pavimentos ;
     bim:é.qualificadora.de    bim:Sistemas.Paisagísticos  .

bim:Critério.Qualif.HA02.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.H ;
     bim:é.pertencente.a    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Objetivo.02 ;
     bim:é.dentro.de    bim:Critério.Qualif.HA02 ;
     bim:tema    "Serviços de reflorestamento e manejo de vegetação em áreas de infraestrutura de obras viárias" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Abordar a conectividade ecológica no desenvolvimento da infraestrutura de transporte. O projeto deve demonstrar alinhamento com a orientação global IUCN Guidance: Abordagem da conectividade ecológica no desenvolvimento de estradas, ferrovias e canais (IUCN, 2023)." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.HA02 ;
     bim:é.qualificadora.de    bim:Sistemas.Pavimentos ;
     bim:é.qualificadora.de    bim:Sistemas.Paisagísticos  .

bim:Critério.Qualif.HA03  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
