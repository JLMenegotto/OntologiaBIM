                    rdfs:range               [rdf:type rdfs:Datatype ; owl:unionOf ( rdfs:Literalxsd:string) ]  ;
                    rdfs:label              " [rdf:type rdfs:Datatype ; owl:unionOf ( Dado para gestionar: contêiner.em.andamento -- Formatado como (rdfs:Literalxsd:string)) ] " ;
                    bim:Chave               "d.gestionar.114" ;
