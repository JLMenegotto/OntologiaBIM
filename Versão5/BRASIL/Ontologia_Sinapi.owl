ObjectProperty: bim:p.aplicar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.paginada
	SubPropertyOf: bim:p.aplicar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a aplicar: é.paginada"@pt
	Annotations: bim:Chave "d.aplicar.116"
	Annotations: bim:Ação "Ação de aplicar"@pt
	Annotations: bim:Definição "Declara que um acabamento é aplicado de modo paginada, com uma distribuição geométrica regular e com origem definido."@pt
	Annotations: bim:Definición "Declara que un acabado se aplica de forma paginada, con una distribución geométrica regular y con un origen definido."@es
	Annotations: bim:Definition "Declares that a finish is applied in a paginated fashion, with a regular geometric distribution and with a defined origin."@en
	Annotations: bim:CatRevit "[ OST_Parts : OST_Walls : OST_Floors : OST_Ceilings : OST_FloorsFinish1 : OST_FloorsFinish2 : OST_WallsFinish1 : OST_WallsFinish2 : OST_CeilingsFinish1 : OST_CeilingsFinish2  ]"
	Annotations: bim:ClasseIfc "[ IfcCovering ]"
	EquivalentTo: bim:é.paginado

