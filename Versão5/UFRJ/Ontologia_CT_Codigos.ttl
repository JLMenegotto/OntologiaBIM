bim:Lance.Escada rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Escadas ;
      rdfs:label  "Lance Escada"@pt ;
      bim:Definição   "Lance de escada reta ou curva inclui componentes de uma única 'corrida' de degraus. inclui os degraus e as vigas laterais caso haja."@pt ;
      bim:Definición  "El tramo de escaleras recto o curvo incluye los componentes de un solo 'tránsito' de escalones. Incluye escalones y vigas laterales, si los hubiera."@es ;
      bim:Definition  "Straight or curved flight of stairs includes components of a single 'run' of steps. includes steps and side beams, if any."@en ;
      bim:Natureza    "Circulações"@pt ;
      bim:Espécie     "Verticales"@pt ;
      bim:Tema        "Escadas"@pt ;
      bim:Disciplina  "Arquitetura"@pt ;
