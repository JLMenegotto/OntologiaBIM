bim:é.biossegurança.nb3   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:p.investigar ;
                    rdfs:domain             bim:BIM ;
                    rdfs:label              "Propriedade destinada a investigar: é.biossegurança.nb3" ;
                    bim:Chave               "d.investigar.111" ;
                    bim:Ação                "Ação de investigar" ;
                    bim:Definição           "Declara que é um laboratório de biossegurança nível de segurança 3 ou de contenção. Destinado ao trabalho com agentes de risco biológico da classe 3, microrganismos que acarretam elevado risco ao pesquisador e baixo risco para a comunidade. Consultar ABNT NBR ISO 35001 – Gestão de Biorrisco para Laboratórios e Organizações Relacionadas."@pt ;
                    bim:Definición          "Declara que es un laboratorio de bioseguridad nivel 3 o contención. Destinado a trabajar con agentes de riesgo biológico clase 3, microorganismos que suponen un alto riesgo para el investigador y un bajo riesgo para la comunidad. Consulte ABNT NBR ISO 35001 – Gestión de Bioriesgos para Laboratorios y Organizaciones Relacionadas."@es ;bim:Definition          "Declares that it is a biosafety laboratory security level 3 or containment. Intended for work with class 3 biological risk agents, microorganisms that pose a high risk to the researcher and a low risk to the community.  Consult ABNT NBR ISO 35001 – Biorisk Management for Laboratories and Related Organizations."@en ;
                    bim:CatRevit            "[ OST_Rooms : OST_MEPSpaces : OST_MEPZone ]	" ;
                    bim:ClasseIfc           "[ IfcSpace : IfcOccupant ]" ;
                    owl:equivalentProperty  bim:é.doença.nb3  .


bim:d.investigar   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:BIMData  .


bim:biossegurança.nb3   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:d.investigar ;
                    rdfs:range               [rdf:type rdfs:Datatype ; owl:unionOf ( rdfs:Literalxsd:string) ]  ;
                    rdfs:label              " [rdf:type rdfs:Datatype ; owl:unionOf ( Dado para investigar: biossegurança.nb3 -- Formatado como (rdfs:Literalxsd:string)) ] " ;
                    bim:Chave               "d.investigar.111" ;
                    bim:Ação                "Ação de investigar" ;
                    bim:Definição           "Declara que é um laboratório de biossegurança nível de segurança 3 ou de contenção. Destinado ao trabalho com agentes de risco biológico da classe 3, microrganismos que acarretam elevado risco ao pesquisador e baixo risco para a comunidade. Consultar ABNT NBR ISO 35001 – Gestão de Biorrisco para Laboratórios e Organizações Relacionadas."@pt ;
                    bim:Definición          "Declara que es un laboratorio de bioseguridad nivel 3 o contención. Destinado a trabajar con agentes de riesgo biológico clase 3, microorganismos que suponen un alto riesgo para el investigador y un bajo riesgo para la comunidad. Consulte ABNT NBR ISO 35001 – Gestión de Bioriesgos para Laboratorios y Organizaciones Relacionadas."@es ;bim:Definition          "Declares that it is a biosafety laboratory security level 3 or containment. Intended for work with class 3 biological risk agents, microorganisms that pose a high risk to the researcher and a low risk to the community.  Consult ABNT NBR ISO 35001 – Biorisk Management for Laboratories and Related Organizations."@en ;
