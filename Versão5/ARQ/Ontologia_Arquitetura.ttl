                    bim:ParRevit            "[ ELEM_FAMILY_PARAM : ELEM_TYPE_PARAM : SYMBOL_FAMILY_NAME_PARAM : SYMBOL_ID_PARAM : FAMILY_LEVEL_PARAM ]" ;
                    bim:Método              "[ CatBuscada   FilteredElementCollector(doc).OfCategory((BuiltInCategory)Enum.Parse(typeof(BuiltInCategory))) ]" ;
                    bim:ClasseIfc           "[ IfcGloballyUniqueId : IfcLabel : IfcText : IfcElement.ObjectType : IfcTypeObject ] " ;
                    bim:AtributoIfc         "[ GlobalId : OwnerHistory : Name ]" ;
