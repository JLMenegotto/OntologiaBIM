		<!-- "Alvenarias estruturais usadas no 5° Andar do prédio." -->
		<specification name="Req_Pre_01" ifcVersion="IFC4" identifier="Req_Pre_01" description="Alvenarias estruturais usadas no 5° Andar do prédio.">
			<applicability minOccurs= "1" maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCWALL</simpleValue></name>
				</entity>
				<partOf  relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" >
					<entity>
					<name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name>
					</entity>
				</partOf>
				<classification>
					<system><simpleValue>NBR-15965-3E</simpleValue></system>
					<value><simpleValue>3E.14.02</simpleValue></value>
				</classification>
				<attribute>
					<name><simpleValue>Name</simpleValue></name>
					<xs:restriction base="xs:string">
						<xs:pattern value="Andar 5*.*"/>
					</xs:restriction>
				</attribute>
			</applicability>
			<requirements>
				<property  dataType="IFCBOOLEAN"  cardinality="required">
					<propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
					<baseName><simpleValue>LoadBearing</simpleValue></baseName>
					<value><simpleValue>True</simpleValue></value>
				</property>
			</requirements>
		</specification>

		<!-- "Material proibido." -->
		<specification name="Req_Mat_Proibido_01" ifcVersion="IFC4" identifier="Req_Mat_Proibido_01" description="Material proibido.">
			<applicability>
				<entity>
					<name><simpleValue>IFCMATERIAL</simpleValue></name>
				</entity>
