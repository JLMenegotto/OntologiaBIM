	Annotations: rdfs:label "Propriedade destinada a orientar: é.a.barlavento"@pt
	Annotations: bim:Chave "d.orientar.102"
	Annotations: bim:Ação "Ação de orientar"@pt
	Annotations: bim:Definição "Declara que o elemento está orientado a barlavento, ou seja exposto à força do vento."@pt
	Annotations: bim:Definición "Declara que el elemento está orientado a barlovento, es decir, expuesto a la fuerza del viento."@es
	Annotations: bim:Definition "Declares that the element is oriented to windward, that is, exposed to the force of the wind."@en
	InverseOf: bim:é.a.sotavento

