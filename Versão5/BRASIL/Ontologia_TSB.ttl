     bim:é.qualificadora.de    bim:Sistemas.Construtivos ;
     bim:é.qualificadora.de    bim:Sistemas.Elétricos  .

bim:Critério.Qualif.F04.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.F04 ;
     bim:tema    "Instalação de pontos de recarga para veículos elétricos nos edifícios" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Atenda ao menos 5% das vagas disponíveis no estacionamento, com previsão de infraestrutura para expansão até pelo menos 20% das vagas." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F04 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos ;
     bim:é.qualificadora.de    bim:Sistemas.Elétricos  .

bim:Critério.Qualif.F04.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.F04 ;
     bim:tema    "Instalação de pontos de recarga para veículos elétricos nos edifícios" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Seja acompanhada de investimento proporcionalmente equivalente em geração para autoconsumo local de energia de fontes renováveis." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F04 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos ;
     bim:é.qualificadora.de    bim:Sistemas.Elétricos  .

bim:Critério.Qualif.F05  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Instalação de sistemas e equipamentos para geração local de energia de fontes renováveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A atividade será considerada qualificada, desde que atenda A e B. As medidas individuais incluem, entre outros: 1) Sistemas solares fotovoltaicos (e equipamentos técnicos auxiliares). 2) Equipamentos de aquecimento de água por fonte solar ou biomassa. 3) Turbinas eólicas (e equipamento técnico auxiliar). 4) Unidades de armazenamento de energia térmica ou elétrica (e equipamento técnico auxiliar). 5) Trocadores de calor/sistemas de recuperação de energia." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F05 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.F05.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.F05 ;
     bim:tema    "Instalação de sistemas e equipamentos para geração local de energia de fontes renováveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A edificação seja classificável como eficiente em termos de consumo de energia dentro de sua tipologia, ou tenham sido implementadas previamente medidas para melhoria do desempenho energético, como as descritas na atividade F3." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F05 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.F05.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.F05 ;
     bim:tema    "Instalação de sistemas e equipamentos para geração local de energia de fontes renováveis" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A geração para autoconsumo local seja equivalente a pelo menos 20% do consumo médio do sistema ou da edificação, com meta de progressão para 50% até 2030." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F05 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.F06  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Atividades imobiliárias" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificarem como contribuição substancial, Aas atividades qualificadas deverão demonstrar alinhamento com os critérios A ou B. " ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F06 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.F06.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.F06 ;
     bim:tema    "Atividades imobiliárias" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Evidência da eficiência da gestão operacional por meio de monitoramento e avaliação do desempenho energético, apresentando uma destas opções: • Contrato de desempenho de economia de energia (Energy Performance Contract – EPC / Energy Service Company – ESCO). • Certificação do sistema de gestão de energia do edifício pela norma ABNT NBR ISO 50001. • Certificação do sistema de gestão ambiental do edifício, englobando objetivos de redução de consumo de água e energia, e de envio de resíduos a aterro, pela norma ABNT NBR ISO 14001. • Certificação LEED Existing Building." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F06 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.F06.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.F06 ;
     bim:tema    "Atividades imobiliárias" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Comprovação documentada da redução na DEP anual (kWh/m²/ano), e no consumo de água, de acordo com os planos anuais ou plurianuais de economia documentados, bem como do plano de gestão hídrica elaborado conforme norma NBR 17682. A redução deverá ser evidenciada mediante autodeclaração do responsável técnico, acompanhada pela emissão de ART ou RRT para garantir a conformidade, e estar disponível a todas as partes interessadas. " ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F06 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.F07  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Atividades de pesquisa, desenvolvimento e inovação para o setor" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Criação de ativos intangíveis e realização de atividades de pesquisa, desenvolvimento e inovação explicitamente voltadas a facilitar o cumprimento dos critérios de contribuição substancial da TSB e o atingimento dos limites estabelecidos para o setor CNAE F." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.F07 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.FA01  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.02 ;
     bim:tema    "Melhorias na resiliência dos edifícios" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade ou medida deve demonstrar a redução do risco climático ou a melhoria da resiliência, conforme as categorias abaixo: 1) Ativo ou atividade de risco baixo ou moderado do ativo ou atividade: apresentação de estudo qualitativo e/ou quantitativo. 2) Ativo ou atividade de risco alto: realização de avaliação de vulnerabilidade conforme o processo completo descrito na metodologia específica do Anexo A2. Os níveis de risco devem ser determinados conforme as seções 1.1 e 1.2 do Anexo A2." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.FA01 ;
     bim:é.qualificadora.de    bim:Sistemas.Construtivos  .

bim:Critério.Qualif.FA02  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.02 ;
     bim:tema    "Implementação de Sistemas de Drenagem Sustentável (SUDS) ou outra infraestrutura verde e azul para gerenciamento de águas pluviais em ambientes urbanos e de desenvolvimento urbano" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade deve levar à retenção de águas pluviais em uma área específica ou a uma melhoria na qualidade da água e deve atender aos seguintes critérios A B C D E." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.FA02 ;
     bim:é.qualificadora.de    bim:Sistemas.Pluviais  .

bim:Critério.Qualif.FA02.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.F ;
     bim:é.pertencente.a    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Objetivo.02 ;
     bim:é.dentro.de    bim:Critério.Qualif.FA02 ;
     bim:tema    "Implementação de Sistemas de Drenagem Sustentável (SUDS) ou outra infraestrutura verde e azul para gerenciamento de águas pluviais em ambientes urbanos e de desenvolvimento urbano" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A construção e a operação do SUDS devem ser integradas à rede de drenagem urbana, e devem prever a construção e ampliação de superfícies urbanas permeáveis e considerar a adoção de soluções baseadas na natureza. No caso da não existência de rede de drenagem urbana, deve-se prever a implantação de soluções de drenagem nos moldes acima. Além disso, deve ser demonstrado, por meio de um plano de gestão de risco de inundação ou de outros instrumentos de planejamento urbano relevantes, que a atividade contribui substancialmente para alcançar o bom estado e o potencial ecológico dos corpos de água superficiais e subterrâneos ou para evitar a deterioração dos corpos d’água." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.FA02 ;
     bim:é.qualificadora.de    bim:Sistemas.Pluviais  .

