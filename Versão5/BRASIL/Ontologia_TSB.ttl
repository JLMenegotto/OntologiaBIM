bim:Critério.NPS.9.04  rdf:type  owl:NamedIndividual , bim:Critério.NPS ;
     bim:é.pertencente.a    bim:Taxonomia.TSB ;
     bim:é.aplicado.em    bim:Objetivo.09 ;
     bim:é.aplicado.em    bim:Setor.TSB.SAS ;
     bim:é.não.prejudicar    bim:NPS.Discriminação.01 ;
     bim:tema    "Critérios NPS: Discriminação.01" ;
     bim:não.prejudicar    "NPS.Discriminação.01" ;
     bim:tema    "Violência, discriminação e assédio" ;
     bim:dimensão    "Relações com pessoas trabalhadoras, empresas terceirizadas, fornecedoras, empresas consumidoras, clientes e com a comunidade" ;
     bim:nível.de.atuação    "Processos" ;
     bim:disponível.em    "ETHOS , 23.2.5 , GPTW , WEP.Q.2 , WEP.Q.10 , IEER.Nível.2 , PRÓ.EQUIDADE.7.1 " ;
     bim:orientação.de.preenchimento     "Os canais confidenciais podem ser próprios ou gerenciado por um terceiro independente. Garante-se à pessoa denunciante confidencialidade (caso a pessoa se identifique) ou o anonimato (caso a pessoa opte por não se identificar) e não retaliação"  .

bim:Critério.Qualif.B01  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.B ;
     bim:é.pertencente.a    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Mineração de minério de ferro" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificarem como contribuição substancial, as atividades do setor deverão demonstrar alinhamento com os critérios A, B e C." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.B01 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.B01.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.B ;
     bim:é.pertencente.a    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.B01 ;
     bim:é.explicado.em    bim:Nota.B.02 ;
     bim:tema    "Mineração de minério de ferro" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A energia elétrica utilizada deverá ser proveniente de usinas que utilizem fontes e tecnologias de geração de energia incluídas no caderno CNAE D – Eletricidade e Gás da TSB, por meio de geração própria, Contratos de Compra de Energia no Ambiente de Contratação Livre (ACL) ou no mercado de curto prazo do Sistema Interligado Nacional (SIN), ou, ainda, por meio da compra de energia no mercado regulado, diretamente das distribuidoras" ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.B01 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.B01.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.B ;
     bim:é.pertencente.a    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.B01 ;
     bim:é.explicado.em    bim:Nota.B.03 ;
     bim:tema    "Mineração de minério de ferro" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A emissão dos escopos 1 e 2 por tonelada de minério bruto (Run of Mine – ROM, na sua sigla em inglês) relativas à extração e beneficiamento contínuo não envolvendo sinterização e pelotização deve ser menor ou igual à 0,008 tCO2e/t minério." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.B01 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.B01.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.B ;
     bim:é.pertencente.a    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.B01 ;
     bim:tema    "Mineração de minério de ferro" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "A venda de minério deve estar inserida em cadeias de valor que resultem em atividades econômicas que comprovadamente contribuam de forma substancial para a mitigação da mudança do clima: 1) Ferro – a venda de minério deve estar direcionada a atividades econômicas de produção de ferro e aço (CNAE C, grupos 24.1 e 24.2, descritos na atividade), em conformidade com critérios técnicos estabelecidos na TSB ou em taxonomias internacionais para a mitigação da mudança do clima." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.B01 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

