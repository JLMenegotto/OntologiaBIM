	range: rdfs:Literal or xsd:string
	Annotations: rdfs:label "Dado para conectar: zona.sem.redundância -- Formatado como (rdfs:Literal or xsd:string)"@pt
	Annotations: bim:Chave "d.conectar.133"
	Annotations: bim:Ação "Ação de conectar"@pt
	Annotations: bim:Definição "Declara que na zona ou região o provedor local não possui redundância, tornando a conexão instável."@pt
	Annotations: bim:Definición "Declara que en la zona o región el proveedor local no tiene redundancia, lo que hace que la conexión sea inestable."@es
	Annotations: bim:Definition "Declares that in the zone or region the local provider does not have redundancy, making the connection unstable."@en
	Annotations: bim:CatRevit "[ OST_MEPZone ]"
	Annotations: bim:ClasseIfc "[ IfcZone ]"

