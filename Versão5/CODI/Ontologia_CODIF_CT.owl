DataProperty: bim:chapiscado.com
	SubPropertyOf: bim:d.rebocar
	range: rdfs:Literal  or  xsd:string
	Annotations: rdfs:label "Dado para rebocar:  chapiscado.com  Deve ser formatado como (rdfs:Literal  or  xsd:string)"@pt
	Annotations: bim:Chave "d.rebocar.103"
	Annotations: bim:Ação "Ação de rebocar"@pt
	Annotations: bim:Definição "Declara que um elemento é chapiscado com alguma argamassa."@pt
	Annotations: bim:Definición "Declara que un elemento está salpicado con algo de mortero."@es
	Annotations: bim:Definition "Declares that an element is plastered with some mortar."@en

ObjectProperty: bim:p.rebocar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.emboçada.com
	SubPropertyOf: bim:p.rebocar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a rebocar: é.emboçada.com"@pt
	Annotations: bim:Chave "d.rebocar.104"
	Annotations: bim:Ação "Ação de rebocar"@pt
	Annotations: bim:Definição "Declara que uma parede é emboçada com alguma argamassa aplicada na superfície para corrigir imperfeições da alvenaria."@pt
	Annotations: bim:Definición "Declara que una pared se enlucida con algo de mortero aplicado a la superficie para corregir las imperfecciones de la mampostería."@es
	Annotations: bim:Definition "Declares that a wall is plastered with some mortar applied to the surface to correct masonry imperfections."@en
	EquivalentTo: bim:é.emboçado.com

