                    rdfs:subPropertyOf      bim:BIMProp  .


bim:é.rua.nível   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:p.trafegar ;
                    rdfs:domain             bim:BIM ;
                    rdfs:label              "Propriedade destinada a trafegar: é.rua.nível" ;
                    bim:Chave               "d.trafegar.101" ;
                    bim:Ação                "Ação de trafegar" ;
                    bim:Definição           "Declara o nível da rua em relação a outra via de tráfego. Atributos (layer ou z_order em sistemas GIS. 0 = Nível do solo; Valores 1, 2, 3... Níveis acima do solo;  Valores -1, -2, -3 níveis abaixo do solo."@pt ;
                    bim:Definición          "Declara el nivel de la calle en relación con otro carril de tráfico. Atributos (capa o z_order en sistemas SIG. 0 = Nivel del suelo; Valores 1, 2, 3... Niveles elevados; Valores -1, -2, -3 niveles bajo tierra."@es ;bim:Definition          "Declares the level of the street in relation to another traffic lane. Attributes (layer or z_order in GIS systems. 0 = Ground level; Values 1, 2, 3... Above-ground levels; Values -1, -2, -3 levels below ground."@en ;
                    bim:CatRevit            "[ OST_Floors ]" ;
                    bim:ClasseIfc           "[ IfcAlignment : IfcSlab : IfcCourse ]" ;
                    owl:equivalentProperty  bim:é.viaduto.nível  .


