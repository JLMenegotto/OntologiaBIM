ObjectProperty: bim:é.leito.de.tratamento.semi-intensivo
	SubPropertyOf: bim:p.hospitalizar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a hospitalizar: é.leito.de.tratamento.semi-intensivo"@pt
	Annotations: bim:Chave "d.hospitalizar.122"
	Annotations: bim:Ação "Ação de hospitalizar"@pt
	Annotations: bim:Definição "Declara o ID de Revit ou GlobalId IFC ou identificador único de objeto. É um leito hospitalar para pacientes que não precisam de UTI, mas requerem atenção especial. Parâmetro da Secretaria Municipal de Saúde do Rio de Janeiro."@pt
	Annotations: bim:Definición "Declara el ID de Revit o IFC GlobalId o un identificador único de objeto. Es una cama de hospital para pacientes que no necesitan UCI, pero sí que requieren atención especial. Parámetro del Departamento de Sanidad Municipal de Río de Janeiro."@es
	Annotations: bim:Definition "Declares the Revit ID or IFC GlobalId or unique object identifier. It is a hospital bed for patients who do not need an ICU, but require special attention. Parameter of the Municipal Health Department of Rio de Janeiro."@en
	Annotations: bim:CatRevit "[ OST_MedicalEquipment :  OST_NurseCallDevices : OST_Furnitures ]"
	Annotations: bim:ClasseIfc "[ IfcFurniture : IfcMedicalDevice ]"
	Annotations: bim:Código.ABNT "[ 2C.74.36.02.02 ]"
