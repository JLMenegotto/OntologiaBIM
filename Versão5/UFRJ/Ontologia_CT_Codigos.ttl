bim:Escada rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Escadas ;
      rdfs:label  "Escada"@pt ;
      bim:Definição   "Escada é uma circulação vertical que permite que os ocupantes de um edifício se dirigirem a outros andares caminhando, sem utilizar elevadores."@pt ;
      bim:Definición  "Las escaleras son una circulación vertical que permite a los ocupantes de um prédio se dirigir a otros pisos caminando, sem utilizar ascensores."@es ;
      bim:Definition  "A staircase is a vertical circulation that allows the occupants of a building to move to other floors by walking, without using elevators."@en ;
      bim:Natureza    "Circulações"@pt ;
      bim:Espécie     "Verticales"@pt ;
      bim:Tema        "Escadas"@pt ;
      bim:Disciplina  "Arquitetura"@pt ;
      bim:Chave       "Key-COD-634"@pt ;
      bim:CatRevit    "[ OST_Stairs ]"   ;
      bim:ParRevit    "[ - ]"   ;
      bim:AtributoIfc "[ - ]"   ;
      bim:ClasseIfc   "[ IfcStair ]"   ;
      bim:ABNT        "[ - ]"    .


