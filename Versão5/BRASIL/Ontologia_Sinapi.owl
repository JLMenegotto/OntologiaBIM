ObjectProperty: bim:p.objetivar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.ods.02.08
	SubPropertyOf: bim:p.objetivar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a objetivar: é.ods.02.08"@pt
	Annotations: bim:Chave "d.objetivar.116"
	Annotations: bim:Ação "Ação de objetivar"@pt
	Annotations: bim:Definição "Declara que objetiva o ODS para Fome Zero e Agricultura Sustentável. - 2.c Garantir funcionamento adequado dos mercados de commodities de alimentos e seus derivados, e facilitar o acesso oportuno à informação de mercado, inclusive sobre as reservas de alimentos, a fim de ajudar a limitar a volatilidade extrema dos preços dos alimentos."@pt
	Annotations: bim:Definición "Declara que su objetivo es el ODS para el Hambre Cero y la Agricultura Sostenible. - 2.c Garantizar el correcto funcionamiento de los mercados de productos alimentarios y productos alimentarios, y facilitar el acceso oportuno a la información del mercado, incluyendo las existencias de alimentos, para ayudar a limitar la volatilidad extrema de los precios de los alimentos."@es
	Annotations: bim:Definition "Declares that it aims at the SDG for Zero Hunger and Sustainable Agriculture. - 2.c Ensure the proper functioning of food commodity and food commodity markets, and facilitate timely access to market information, including on food stocks, to help limit extreme food price volatility."@en
	EquivalentTo: bim:é.esg.social.direitos.humanos

