ObjectProperty: bim:é.armadura
	SubPropertyOf: bim:p.reforçar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a reforçar: é.armadura"@pt
	Annotations: bim:Chave "d.reforçar.100"
	Annotations: bim:Ação "Ação de reforçar"@pt
	Annotations: bim:Definição "Declara que é uma armadura de reforço estrutural."@pt
	Annotations: bim:Definición "Declara que el objeto es una armadura de refuerzo estructural."@es
	Annotations: bim:Definition "Declares that the object is fit for use as structural bar reinforcement."@en
