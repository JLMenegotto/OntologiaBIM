     bim:tema    "Critérios NPS: Prevenção e controle de contaminação" ;
     bim:não.prejudicar    "Gestão da poluição: assegurar o descarte e o tratamento adequados de resíduos, inclusive resíduos de cozinha e embalagens, para evitar a contaminação ambiental"  .

bim:NPS.Proteção.Marinha.01  rdf:type  owl:NamedIndividual , bim:Critério.NPS ;
