bim:Ardósia rdf:type  owl:Class  ;
      rdfs:subClassOf  bim:Pedras ;
      rdfs:label  "Ardósia"@pt ;
      bim:Definição   "Originada em argila ou xisto submetidos a metamorfismo de baixo grau. Composta por quartzo, mica, clorita. De granulação fina, clivagem em lâminas finas, cores escuras. Usada e telhados, pisos, fachadas, mesas e lousas escolares."@pt ;
      bim:Definición  "Se originó en arcilla o lutita sometida a metamorfismo de bajo grado. Compuesto de cuarzo, mica, clorita. De grano fino, escote en hojas finas, colores oscuros. Usados, tejados, suelos, fachadas, mesas y pizarras escolares."@es ;
      bim:Definition  "Originated in clay or shale subjected to low-grade metamorphism. Composed of quartz, mica, chlorite. Fine-grained, cleavage into thin blades, dark colors. Used and roofs, floors, facades, tables and school blackboards."@en ;
      bim:Natureza    "Materialidades"@pt ;
      bim:Espécie     "Materiais Pétreos"@pt ;
      bim:Tema        "Pedras"@pt ;
      bim:Disciplina  "Interdisciplinar"@pt ;
      bim:Chave       "Key-MAT-169"@pt ;
      bim:CatRevit    "[ OST_Materials : OST_MaterialTags ]"   ;
      bim:ParRevit    "[ - ]"   ;
      bim:AtributoIfc "[ - ]"   ;
      bim:ClasseIfc   "[ IfcMaterial : IfcText : IfcLabel : IfcMaterialRelationship ]"   ;
      bim:ABNT        "[ 0M.20.10.01.50 ]"    .


