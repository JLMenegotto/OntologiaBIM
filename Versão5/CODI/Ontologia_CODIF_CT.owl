ObjectProperty: bim:é.armadura.negativa
	SubPropertyOf: bim:p.reforçar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a reforçar: é.armadura.negativa"@pt
	Annotations: bim:Chave "d.reforçar.104"
	Annotations: bim:Ação "Ação de reforçar"@pt
	Annotations: bim:Definição "Declara que é uma armadura principal negativa para estrutura de concreto armado. Consultar ABNT NBR 6118 e NBR 7480."@pt
	Annotations: bim:Definición "Declara que es un refuerzo principal negativo para estructuras de hormigón armado. Consulta ABNT NBR 6118 y NBR 7480."@es
	Annotations: bim:Definition "Declares that it is a negative main reinforcement for reinforced concrete structure. Consult ABNT NBR 6118 and NBR 7480."@en
	Annotations: bim:CatRevit "[ OST_Rebar ]"
	Annotations: bim:ClasseIfc "[ IfcReinforcingBar ]"
	Annotations: bim:ABNT "[ 2C.04 : 3E.12.06 ]"
	InverseOf: bim:é.armadura.positiva
	EquivalentTo: bim:é.armadura

