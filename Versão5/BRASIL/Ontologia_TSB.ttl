     bim:é.dentro.de    bim:Critério.Qualif.C06 ;
     bim:tema    "Produção de produtos químicos inorgânicos" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para a produção de amônia e ureia, tecnologias que permitam recuperação de amônia de água residual são diretamente qualificadas." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C06 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.C07  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:tema    "Produção de papel e celulose" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Para se qualificar como uma contribuição substancial, a atividade deve atender aos critérios A, B, C e D (se aplicável)." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C07 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.C07.A  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.C07 ;
     bim:é.explicado.em    bim:Nota.C.35 ;
     bim:tema    "Produção de papel e celulose" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Apresentação de relatórios anuais com a quantificação de emissões de GEE de escopo 1 e 2, seguindo os critérios estabelecidos na norma NBR ISO 14064. A atividade deve atender aos limites máximos de intensidade de escopo 1 e 2 definidos para os diferentes produtos inclusos neste caderno. Em no máximo dois anos após a publicação da TSB, ou em prazo anterior, caso seja possível o estabelecimento de uma linha de base, este componente do critério deve ser atualizado com o limite máximo de intensidade de emissões de GEE de escopo 1 e 2 para que a atividade seja considerada qualificada" ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C07 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.C07.B  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.C07 ;
     bim:tema    "Produção de papel e celulose" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "As matérias-primas para a produção de papel e celulose devem seguir os seguintes critérios (se aplicável): 1) Matéria-prima virgem deve atender aos critérios de contribuição substancial para as atividades correspondentes em nível de fazenda nos setores de Agricultura, Pecuária, Silvicultura, Pesca e Aquicultura, ou deve ser certificada por padrões de sustentabilidade reconhecidos: a) Forest Stewardship Council (FSC). b) Programme for the Endorsement of Forest Certification (PEFC). 2) Matéria-prima reciclável é diretamente qualificada. 3) Caso haja uma mistura de ambos os tipos de matérias-primas (virgem e recicladas), deve-se obter as certificações referentes ao uso de matéria-prima virgem, mencionadas no primeiro ponto deste critério B." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C07 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.C07.C  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.C07 ;
     bim:tema    "Produção de papel e celulose" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "Aumento no consumo de energia renovável, considerando o uso total de eletricidade, aquecimento, resfriamento e vapor, segundo as diretrizes do GRI 302 (GSSB, 2016), tanto para a indústria de papel quanto para a indústria de celulose. Em no máximo dois anos após a publicação da TSB ou em prazo anterior, serão definidos os limites mínimos de consumo de energia renovável." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C07 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.C07.D  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
     bim:é.dentro.de    bim:Caderno.C ;
     bim:é.pertencente.a    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.dentro.de    bim:Critério.Qualif.C07 ;
     bim:tema    "Produção de papel e celulose" ;
     bim:descrição    "Critério necessário para que a atividade seja considerada alinhada com os objetivos" ;
     bim:contribuição.substancial.de    "No ativo florestal, manutenção de estoque ou aumento verificado das remoções florestais, se aplicável." ;
     bim:é.qualificadora.de    bim:Atividade.Elegível.C07 ;
     bim:é.qualificadora.de    bim:Sistemas.Produtivos  .

bim:Critério.Qualif.C08  rdf:type  owl:NamedIndividual , bim:Critério.Positivo ;
