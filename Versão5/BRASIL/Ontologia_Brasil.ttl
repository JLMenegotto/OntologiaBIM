bim:d.zonificar   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:BIMData  .


bim:zona.pública   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:d.zonificar ;
                    rdfs:range               [rdf:type rdfs:Datatype ; owl:unionOf ( rdfs:Literalxsd:string) ]  ;
                    rdfs:label              " [rdf:type rdfs:Datatype ; owl:unionOf ( Dado para zonificar: zona.pública -- Formatado como (rdfs:Literalxsd:string)) ] " ;
                    bim:Chave               "d.zonificar.108" ;
                    bim:Ação                "Ação de zonificar" ;
                    bim:Definição           "Declara a Identificação de zona pública. "@pt ;
                    bim:Definición          "Declara la Identificación de área pública."@es ;bim:Definition          "Declares the identification of public area."@en ;
                    bim:CatRevit            "[ OST_MEPZone ]" ;
                    bim:ClasseIfc           "[ IfcZone ]"  .

