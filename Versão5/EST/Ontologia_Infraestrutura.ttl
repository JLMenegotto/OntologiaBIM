      rdfs:subClassOf  bim:Marcos ;
      rdfs:label  "Marco.de.Fronteira"@pt ;
      bim:Definição   "Representa onde um limite administrativo (cidade ou estado) ou de manutenção (empresas ou regionais diferentes) cruza o elemento linear (trilhos ou estradas) que está sendo medido."@pt ;
      bim:Definición  "Representa el punto en el que un límite administrativo (ciudad o estado) o de mantenimiento (diferentes empresas o regiones) interseca el elemento lineal (vías férreas o carreteras) que se está midiendo."@es ;
      bim:Definition  "Represents where an administrative (city or state) or maintenance boundary (different companies or regionals) intersects the linear element (rails or roads) being measured."@en ;
      bim:Natureza    "Fronteiras"@pt ;
      bim:Espécie     "Demarcadas"@pt ;
      bim:Tema        "Marcos"@pt ;
      bim:Disciplina  "Interdisciplinar"@pt ;
      bim:Chave       "Key-INFRA-31"@pt ;
      bim:ClasseIfc   "[ IfcReferentINTERSECTION ]"    .


