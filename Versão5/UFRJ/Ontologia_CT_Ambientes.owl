DataProperty: bim:colada.com
	SubPropertyOf: bim:d.assentar
	range: rdfs:Literal  or  xsd:string
	Annotations: rdfs:label "Dado para assentar:  colada.com  Deve ser formatado como (rdfs:Literal  or  xsd:string)"@pt
	Annotations: bim:Chave "d.assentar.102"
	Annotations: bim:Ação "Ação de assentar"@pt
	Annotations: bim:Definição "Declara que um elemento é colada com alguma argamassa ou cola."@pt
	Annotations: bim:Definición "Declara que un elemento está pegado con algún mortero o pegamento."@es
	Annotations: bim:Definition "Declares that an element is glued together with some mortar or glue."@en
	Annotations: bim:CatRevit "[ OST_Walls : OST_WallCoreLayer : OST_WallsInsulation : OST_WallsSubstrate : OST_Parts ]"
	Annotations: bim:ClasseIfc "[ IfcWall ]"
	Annotations: bim:ABNT "[ 3E.14.02.02 ]"

