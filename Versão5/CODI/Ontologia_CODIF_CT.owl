Class: bim:Escadas
	Annotations: rdfs:label "Escadas"@pt
	SubClassOf: bim:Verticales


Class: bim:Escada
	Annotations: rdfs:label "Escada"@pt
	Annotations: bim:Definição "Escada é uma circulação vertical que permite que os ocupantes de um edifício se dirigirem a outros andares caminhando, sem utilizar elevadores."@pt
	Annotations: bim:Definición "Las escaleras son una circulación vertical que permite a los ocupantes de um prédio se dirigir a otros pisos caminando, sem utilizar ascensores."@es
	Annotations: bim:Definition "A staircase is a vertical circulation that allows the occupants of a building to move to other floors by walking, without using elevators."@en
	Annotations: bim:Natureza "Circulações"@pt
	Annotations: bim:Espécie "Verticales"@pt
	Annotations: bim:Tema "Escadas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-634"
	Annotations: bim:CatRevit "[ OST_Stairs ]"
	Annotations: bim:ClasseIfc "[ IfcStair ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Escadas


Class: bim:Lance.Escada
	Annotations: rdfs:label "Lance Escada"@pt
	Annotations: bim:Definição "Lance de escada reta ou curva inclui componentes de uma única 'corrida' de degraus. inclui os degraus e as vigas laterais caso haja."@pt
	Annotations: bim:Definición "El tramo de escaleras recto o curvo incluye los componentes de un solo 'tránsito' de escalones. Incluye escalones y vigas laterales, si los hubiera."@es
	Annotations: bim:Definition "Straight or curved flight of stairs includes components of a single 'run' of steps. includes steps and side beams, if any."@en
	Annotations: bim:Natureza "Circulações"@pt
	Annotations: bim:Espécie "Verticales"@pt
	Annotations: bim:Tema "Escadas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-635"
	Annotations: bim:CatRevit "[ OST_Stairs ]"
	Annotations: bim:ClasseIfc "[ IfcStairFlight ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Escadas


