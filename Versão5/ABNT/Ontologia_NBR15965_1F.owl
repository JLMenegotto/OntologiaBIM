ObjectProperty: bim:é.descrição
	SubPropertyOf: bim:p.catalogar
	domain: bim:BIM
	Annotations: rdfs:comment "Propriedade destinada a catalogar: é.descrição"@pt
	Annotations: bim:Chave "d.catalogar.110"
	Annotations: bim:Ação "Ação de catalogar"@pt
	Annotations: bim:Definição "Declara a descrição do objeto que pode ser uma explicação sucinta."@pt
	Annotations: bim:Definición "Declara la descripción del objeto, lo que puede ser una explicación concisa."@es
	Annotations: bim:Definition "Declare the description of the object which can be a succinct explanation."@en
	Annotations: bim:CódigoABNT "[ 0P.10 ]"

