bim:é.resistência.térmica   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:p.energizar ;
                    rdfs:domain             bim:BIM ;
                    rdfs:label              "Propriedade destinada a energizar: é.resistência.térmica" ;
                    bim:Chave               "d.energizar.115" ;
                    bim:Ação                "Ação de energizar" ;
                    bim:Definição           "Declara a capacidade de um material resistir à passagem de calor. Expressado em m²·K/W. A maior resistência melhor isolamento. "@pt ;
                    bim:Definición          "Declara la capacidad de un material para resistir el paso del calor. Expresado en m²· K/W. Cuanto mayor sea la resistencia, mejor aislamiento."@es ;bim:Definition          "Declares the ability of a material to resist the passage of heat. Expressed in m²· K/W. The higher resistance better insulation."@en ;
                    owl:inverseOf           bim:é.transmitância.térmica  .


bim:d.energizar   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:BIMData  .


bim:resistência.térmica   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:d.energizar ;
                    rdfs:range              xsd:double ;
                    rdfs:label              "Dado para energizar: resistência.térmica -- Formatado como (xsd:double)" ;
                    bim:Chave               "d.energizar.115" ;
                    bim:Ação                "Ação de energizar" ;
                    bim:Definição           "Declara a capacidade de um material resistir à passagem de calor. Expressado em m²·K/W. A maior resistência melhor isolamento. "@pt ;
                    bim:Definición          "Declara la capacidad de un material para resistir el paso del calor. Expresado en m²· K/W. Cuanto mayor sea la resistencia, mejor aislamiento."@es ;bim:Definition          "Declares the ability of a material to resist the passage of heat. Expressed in m²· K/W. The higher resistance better insulation."@en  .


bim:p.energizar   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:BIMProp  .


bim:é.transmitância.térmica   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:p.energizar ;
                    rdfs:domain             bim:BIM ;
                    rdfs:label              "Propriedade destinada a energizar: é.transmitância.térmica" ;
                    bim:Chave               "d.energizar.116" ;
                    bim:Ação                "Ação de energizar" ;
                    bim:Definição           "Declara a quantidade de calor que atravessa um elemento construtivo por unidade de área e por diferença de temperatura. Expressada em W/m²·K (Watts por metro quadrado vezes Kelvin). A menor transmitância, melhor isolamento. "@pt ;
                    bim:Definición          "Declara la cantidad de calor que pasa a través de un elemento de construcción por unidad de área y por diferencia de temperatura. Expresado en W/m²· K (Vatios por metro cuadrado por Kelvin). Cuanto menor transmitancia, mejor aislamiento."@es ;bim:Definition          "Declares the amount of heat that passes through a construction element per unit area and per temperature difference. Expressed in W/m²· K (Watts per square meter times Kelvin). The lower transmittance, better insulation."@en ;
                    owl:inverseOf           bim:é.resistência.térmica  .


bim:d.energizar   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:BIMData  .


bim:transmitância.térmica   rdf:type  owl:DatatypeProperty ;
                    rdfs:subPropertyOf      bim:d.energizar ;
                    rdfs:range              xsd:double ;
                    rdfs:label              "Dado para energizar: transmitância.térmica -- Formatado como (xsd:double)" ;
                    bim:Chave               "d.energizar.116" ;
                    bim:Ação                "Ação de energizar" ;
                    bim:Definição           "Declara a quantidade de calor que atravessa um elemento construtivo por unidade de área e por diferença de temperatura. Expressada em W/m²·K (Watts por metro quadrado vezes Kelvin). A menor transmitância, melhor isolamento. "@pt ;
                    bim:Definición          "Declara la cantidad de calor que pasa a través de un elemento de construcción por unidad de área y por diferencia de temperatura. Expresado en W/m²· K (Vatios por metro cuadrado por Kelvin). Cuanto menor transmitancia, mejor aislamiento."@es ;bim:Definition          "Declares the amount of heat that passes through a construction element per unit area and per temperature difference. Expressed in W/m²· K (Watts per square meter times Kelvin). The lower transmittance, better insulation."@en  .


