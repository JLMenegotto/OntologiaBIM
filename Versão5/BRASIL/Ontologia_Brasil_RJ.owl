ObjectProperty: bim:p.medir
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.métrica.manhattan
	SubPropertyOf: bim:p.medir
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a medir: é.métrica.manhattan"@pt
	Annotations: bim:Chave "d.medir.110"
	Annotations: bim:Ação "Ação de medir"@pt
	Annotations: bim:Definição "Declara a distância entre 2 pontos de uma matriz quadrada (X1-X2) + (Y1-Y2) + (Z1-Z2). Também denominada distancia Manhattan, pois seria a distância percorrida em uma cidade com ruas em grade, independente do caminho."@pt
	Annotations: bim:Definición "Declara la distancia entre 2 puntos de una matriz cuadrada (X1-X2) + (Y1-Y2) + (Z1-Z2). También llamada distancia de Manhattan, porque sería la distancia recorrida en una ciudad con calles en cuadrícula, independientemente del camino."@es
	Annotations: bim:Definition "Declares the distance between 2 points of a square matrix (X1-X2) + (Y1-Y2) + (Z1-Z2). Also called Manhattan distance, because it would be the distance traveled in a city with gridded streets, regardless of the path."@en
	EquivalentTo: bim:é.métrica.taxicab

DataProperty: bim:d.medir
	SubPropertyOf: bim:BIMData



DataProperty: bim:métrica.manhattan
	SubPropertyOf: bim:d.medir
