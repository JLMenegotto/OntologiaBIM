                    rdfs:subPropertyOf      bim:BIMProp  .


bim:é.a.montante.de   rdf:type  owl:ObjectProperty ;
                    rdfs:subPropertyOf      bim:p.esgotar ;
                    rdfs:domain             bim:BIM ;
                    rdfs:label              "Propriedade destinada a esgotar: é.a.montante.de" ;
                    bim:Chave               "d.esgotar.115" ;
                    bim:Ação                "Ação de esgotar" ;
                    bim:Definição           "Declara que o objeto é posicionado a montante de outro objeto (sentido de contrafluxo). Propriedade pensada para ordenar elementos de desagues e tubulações. "@pt ;
                    bim:Definición          "Declara que el objeto está situado aguas arriba de otro objeto (dirección de flujo contrario). Propiedad diseñada para ordenar elementos de caudales y tuberías."@es ;bim:Definition          "Declares that the object is positioned upstream of another object (counterflow direction). Property designed to order elements of flows and pipes."@en ;
