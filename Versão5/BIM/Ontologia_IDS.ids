		<!-- "Janela usada no projeto." -->
		<specification name="Req_Jan_01" ifcVersion="IFC4" identifier="Req_Jan_01" description="Janela usada no projeto.">
			<applicability minOccurs= "1" maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCWINDOW</simpleValue></name>
				</entity>
