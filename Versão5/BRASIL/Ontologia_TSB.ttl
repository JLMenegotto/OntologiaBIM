     bim:tema    "Notas" ;
     bim:nota    "Com base na pegada de carbono da indústria nacional (ABIVIDRO, 2023)."  .

bim:Nota.C.38  rdf:type  owl:NamedIndividual , bim:Nota ;
     bim:é.dentro.de    bim:Caderno.C ;
