ObjectProperty: bim:p.usar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.com.gás.gn
	SubPropertyOf: bim:p.usar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a usar: é.com.gás.gn"@pt
	Annotations: bim:Chave "d.usar.116"
	Annotations: bim:Ação "Ação de usar"@pt
	Annotations: bim:Definição "Declara que usa gás GN (Gás Natural). Composto predominantemente por metano. Distribuído via rede canalizada urbana contínua, sendo mais leve que o ar."@pt
	Annotations: bim:Definición "Declara que utiliza gas NG (Gas Natural). Compuesto predominantemente de metano. Distribuido mediante una red continua de tuberías urbanas, siendo más ligero que el aire."@es
	Annotations: bim:Definition "Declares that it uses NG (Natural Gas) gas. Composed predominantly of methane. Distributed via a continuous urban piped network, being lighter than air."@en
	Annotations: bim:CatRevit "[ OST_PipeSegments : OST_PipeFitting : OST_FlexPipeCurves : OST_PlaceHolderPipes ]"
	Annotations: bim:ClasseIfc "[ IfcPipeSegment : IfcPipeFitting : IfcFilter ]"
	EquivalentTo: bim:é.com.gás.natural

