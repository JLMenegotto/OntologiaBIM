     bim:fora.do.escopo    "-- "  .

bim:Atividade.Elegível.D04  rdf:type  owl:NamedIndividual , bim:Atividade ;
     bim:é.dentro.de    bim:Caderno.D ;
     bim:é.pertencente.a    bim:Setor.TSB.D ;
     bim:é.aplicado.em    bim:Objetivo.01 ;
     bim:é.explicado.em    bim:Nota.D.03 ;
     bim:tema    "Eletricidade e Gás" ;
     bim:código    "D4" ;
     bim:atividade    "Geração de energia elétrica de origem térmica a partir de biomassa renovável, biogás, biometano e outros combustíveis." ;
     bim:descrição    "Implantação, construção, modernização, ampliação, repotenciação, operação e manutenção de instalações que geram energia elétrica a partir de biomassa renovável, biogás, biometano ou outros combustíveis renováveis, incluindo a geração de eletricidade a partir da mistura de biogás/biometano com gás natural." ;
     bim:fora.do.escopo    "Geração de eletricidade a partir de gás natural com limites de uso superiores aos definidos na tabela do item C na seção de Contribuição Substancial desta atividade ou a partir de outros combustíveis fósseis. • Utilização de lodo de esgoto sanitário para geração de eletricidade em processos que não apresentem disposição inadequada. "  .

bim:Atividade.Elegível.D05  rdf:type  owl:NamedIndividual , bim:Atividade ;
     bim:é.dentro.de    bim:Caderno.D ;
     bim:é.pertencente.a    bim:Setor.TSB.D ;
