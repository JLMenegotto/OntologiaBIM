	Annotations: bim:Definição "Dispositivo usado em circuitos ou sistemas de potência devido à sua indutância, atuando como um componente de elétrica."@pt
	Annotations: bim:Definición "Un dispositivo utilizado en circuitos o sistemas de energía debido a su inductancia, que actúa como un componente de la energía eléctrica."@es
	Annotations: bim:Definition "A device used in circuits or power systems due to its inductance, acting as a component of electrical power."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumos Elétricos"@pt
	Annotations: bim:Tema "Fontes Elétricas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-764"
	Annotations: bim:CatRevit "[ OST_ElectricalFixtures : OST_ElectricalConnector ]"
	Annotations: bim:ClasseIfc "[ IfcElectricFlowStorageDeviceINDUCTOR ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Fontes.Elétricas


Class: bim:Banco.de.Indutores
	Annotations: rdfs:label "Banco de Indutores"@pt
	Annotations: bim:Definição "Dispositivo que armazena energia elétrica num campo magnético usando a propriedade elétrica de indutância."@pt
	Annotations: bim:Definición "Dispositivo que almacena energía eléctrica en un campo magnético utilizando la propiedad eléctrica de la inductancia."@es
	Annotations: bim:Definition "A device that stores electrical energy in a magnetic field using the electrical property of inductance."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumos Elétricos"@pt
	Annotations: bim:Tema "Fontes Elétricas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-765"
	Annotations: bim:CatRevit "[ OST_ElectricalFixtures : OST_ElectricalConnector ]"
	Annotations: bim:ClasseIfc "[ IfcElectricFlowStorageDeviceINDUCTORBANK ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Fontes.Elétricas


Class: bim:Recarregador
	Annotations: rdfs:label "Recarregador"@pt
	Annotations: bim:Definição "Recarregador ou carregador de bateria é um dispositivo usado para colocar energia numa célula secundária ou recarregável."@pt
	Annotations: bim:Definición "Un cargador de batería es un dispositivo que se utiliza para alimentar una celda secundaria o recargable."@es
	Annotations: bim:Definition "A battery charger is a device used to put power into a secondary or rechargeable cell."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumos Elétricos"@pt
	Annotations: bim:Tema "Fontes Elétricas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-766"
	Annotations: bim:CatRevit "[ OST_ElectricalFixtures : OST_ElectricalConnector ]"
	Annotations: bim:ClasseIfc "[ IfcElectricFlowStorageDeviceRECHARGER ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Fontes.Elétricas


Class: bim:Fonte.de.Energia
	Annotations: rdfs:label "Fonte de Energia"@pt
	Annotations: bim:Definição "Dispositivo que fornece uma fonte alternativa de fonte de alimentação por tempo limitado em caso de falha."@pt
	Annotations: bim:Definición "Dispositivo que proporciona una fuente alternativa de suministro de energía durante un tiempo limitado en caso de fallo."@es
	Annotations: bim:Definition "Device that provides an alternative source of power supply for a limited time in the event of a failure."@en
	Annotations: bim:Natureza "Insumos"@pt
	Annotations: bim:Espécie "Insumos Elétricos"@pt
	Annotations: bim:Tema "Fontes Elétricas"@pt
	Annotations: bim:Disciplina "Arquitetura"@pt
	Annotations: bim:Chave "Key-COD-767"
	Annotations: bim:CatRevit "[ OST_ElectricalFixtures : OST_ElectricalConnector ]"
	Annotations: bim:ClasseIfc "[ IfcElectricFlowStorageDeviceUPS ]"
	Annotations: bim:ABNT "[ - ]"
	SubClassOf: bim:Fontes.Elétricas


