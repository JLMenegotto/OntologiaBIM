     bim:é.dentro.de    bim:Diretrizes.TSB ;
     bim:é.classe    bim:Diretriz.Integridade ;
     bim:tema    "Diretriz Integridade" ;
     bim:descrição    "Código das Melhores Práticas de Governança Corporativa do Instituto Brasileiro de Governança Corporativa."  .

bim:Diretriz.Integridade.02  rdf:type  owl:NamedIndividual , bim:Diretriz ;
     bim:é.dentro.de    bim:Diretrizes.TSB ;
     bim:é.classe    bim:Diretriz.Integridade ;
     bim:tema    "Diretriz Integridade" ;
     bim:descrição    "Lei Geral de Proteção de Dados Pessoais (Lei nº 13.709/2018)."  .

bim:Indicador.SMT.1  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Humanos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.1" ;
     bim:indicador    "Ausência no Cadastro de Empregadores que tenham submetido trabalhadores a condições análogas à de escravo" ;
     bim:descrição    "A organização não poderá constar na lista pública do Ministério do Trabalho e Emprego ( TEM ), divulgada pela Secretaria de Inspeção do Trabalho (SIT), que inclui empregadores que tenham submetido trabalhadores a condições análogas à escravidão" ;
     bim:encontrado.em    "Consultar em site do MTE "   .

bim:Indicador.SMT.2  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.2" ;
     bim:indicador    "Certidão Negativa de Débitos Trabalhistas ( CNDT )" ;
     bim:descrição    "A organização deverá apresentar a CNDT, emitida pela Justiça do Trabalho, comprovando a inexistência de débitos inadimplidos perante a Justiça do Trabalho em execuções trabalhistas definitivas, conforme o Banco Nacional de Devedores Trabalhistas, centralizado no Tribunal Superior do Trabalho ( TST ). São admitidas certidões positivas com efeito de negativas" ;
     bim:encontrado.em    "Consultar em site do TST "  .

bim:Indicador.SMT.3  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.3" ;
     bim:indicador    "Certidão Negativa de Débitos Trabalhistas decorrentes de autos de infração lavrados por Auditor-Fiscal do Trabalho ( CDT )" ;
     bim:descrição    "A organização deverá apresentar a CDT negativa, atestando a inexistência de débito definitivamente constituído decorrente de infrações trabalhistas e de Saúde e Segurança do Trabalho. São admitidas certidões positivas com efeito de negativas" ;
     bim:encontrado.em    "Consultar em site do SIT/MTE "  .

bim:Indicador.SMT.4  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Igualdade ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.4" ;
     bim:indicador    "Certidão de Regularidade na Contratação de Pessoas com Deficiência e Reabilitados da Previdência Social" ;
     bim:descrição    "A organização deverá apresentar a certidão emitida pela SIT/MTE, comprovando cumprimento da legislação sobre cotas de inclusão (Lei nº 8.213/91), ou documentos correlatos que atestem a regularidade" ;
     bim:encontrado.em    "Consultar em site do SIT/MTE "  .

bim:Indicador.SMT.5  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.5" ;
     bim:indicador    "Gerenciamento de Riscos Ocupacionais ( GRO ), quando aplicável à luz da legislação vigente" ;
     bim:descrição    "Para fins de prevenção e gerenciamento dos riscos ocupacionais, a organização deverá constituir e disponibilizar à Comissão Interna de Prevenção de Acidentes ( CIPA ) e sindicatos um Programa de Gerenciamento de Riscos ( PGR ), ou emitir a Declaração da Inexistência de Risco ( DIR ), de acordo com a Norma Regulamentadora nº 01 (NR-1). A SIT/MTE disponibiliza uma Ferramenta de Avaliação de Risco do PGR para Microempresas e Empresas de Pequeno Porte, com graus de risco 1 e 2 (segundo o Quadro I na NR-04) e que não estejam obrigadas a constituir Serviço Especializado em Engenharia de Segurança e Medicina do  Trabalho. Essas empresas poderão emitir eletronicamente tanto o Inventário de Riscos Ocupacionais quanto o Plano de Ação e a DIR, por meio da ferramenta. Produtores e produtoras familiares com inscrição ativa no Cadastro Nacional da Agricultura Familiar ( CAF ) que contratem apenas empregados de forma eventual e temporária ficam dispensados da obrigação. Para agricultores de pequeno e médio porte, com menos de 20 empregados contratados, admite-se o uso da ferramenta simplificada disponibilizada pela SIT/MTE para micro e pequenas empresas de baixo risco, como evidência válida de conformidade" ;
     bim:encontrado.em    "Apresentada pela organização / entidade produtora"  .

bim:Indicador.SMT.6  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.6" ;
     bim:indicador    "Serviços Especializados em Segurança e em Medicina do Trabalho (SESMT), quando aplicável à luz da legislação vigente" ;
     bim:descrição    "A organização deverá constituir Serviços Especializados em Segurança e Medicina do Trabalho (SESMT), com a finalidade de promover a saúde e proteger a integridade do trabalhador (NR-04). Empreendimentos agrícolas familiares não enquadrados nas exigências da NR-04 ficam dispensados da constituição de SESMT, desde que apresentem o respectivo enquadramento no Grau de Risco e o número de empregados, conforme legislação vigente. Empreendimentos agrícolas não enquadrados nas exigências da NR-04 ficam dispensados de constituição de SESMT (empreendimentos com menos de 50 empregados), desde que apresentem o respectivo e enquadramento no Grau de Risco e número de empregados, conforme legislação vigente" ;
     bim:encontrado.em    "A organização deve apresentar os documentos de comprovação de regularidade do SESMT, cujo registro deve ocorrer por meio de sistema eletrônico"  .

bim:Indicador.SMT.7  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.7" ;
     bim:indicador    "Comprovação de Comissão Interna de Prevenção de Acidentes ( CIPA ), quando aplicável à luz da legislação vigente" ;
     bim:descrição    "A organização deve constituir Comissão Interna de Prevenção de Acidentes e de Assédio ( CIPA ), tendo por objetivo a prevenção de acidentes e doenças relacionadas ao trabalho (NR-05). Para comprovação, a organização poderá apresentar as atas de eleição e posse e a lista de presença das reuniões ordinárias e extraordinárias da Comissão. Para empreendimentos da agricultura familiar, admite-se a adoção de Comissões Internas simplificadas ou outras formas de organização participativa previstas nas diretrizes do MTE para micro empreendimentos. Empreendimento agrícolas de pequeno e médio porte, com menos de 20 empregados contratados, devem comprovar a participação de um representante em treinamentos sobre segurança do trabalho. Produtores/as familiares com inscrição ativa no Cadastro Nacional da Agricultura Familiar ( CAF ) que contratem apenas empregados de forma eventual e temporária ficam dispensados da obrigação" ;
     bim:encontrado.em    "Apresentada pela organização / entidade produtora"  .

bim:Indicador.SMT.8  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Tributária ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.8" ;
     bim:indicador    "Certidão Negativa Conjunta de Débitos Relativos a Tributos Federais e à Dívida Ativa da União" ;
     bim:descrição    "Emitida pela Receita Federal e pela Procuradoria Geral da Fazenda Nacional (PGFN) comprovando a conformidade fiscal federal da organização. São admitidas certidões positivas com efeito de negativas" ;
     bim:encontrado.em    "Emitida através do Portal da Receita Federal"  .

bim:Indicador.SMT.9  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Tributária ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.9" ;
     bim:indicador    "Certidões Negativas de Débitos Tributários Estaduais" ;
     bim:descrição    "Comprovam a ausência de débitos tributários junto às Secretarias da Fazenda estaduais. Normalmente, podem ser obtidas online, mas também é possível pedir certidão física quando não disponível em formato digital. Será necessário justificar quando ausente. São admitidas certidões positivas com efeito de negativas" ;
     bim:encontrado.em    "Emitida nos sites das Secretarias da Fazenda do Estado onde a organização está registrada (quando houver)"  .

bim:Indicador.SMT.10  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.10" ;
     bim:indicador    "Certidão Negativa Correcional ( ePAD , CGU-PJ , CEIS , CNEP e CEPIM )" ;
     bim:descrição    "Comprova a inexistência de sanções ou impedimentos relacionados à integridade, conformidade e regularidade para contratações com o setor público, nas seguintes bases: ePAD (Sistema Eletrônico de Processo Administrativo Disciplinar), CGUPJ (Cadastro de Empresas e Pessoas Jurídicas Punidas), CEIS (Cadastro Nacional de Empresas Inidôneas e Suspensas), CNEP (Cadastro Nacional de Entidades Punidas) e CEPIM (Cadastro de Entidades Privadas Impedidas).  Caso sejam encontradas somente sanções relativamente leves, tendo em conta o conjunto das SM, poderá ser considerada a inclusão na TSB. No caso de cooperativas ou organizações da agricultura familiar, recomenda-se a verificação cruzada com a base do Cadastro Nacional de Agricultura Familiar ( CAF ) para confirmar a natureza da entidade e evitar penalizações indevidas decorrentes de erros relacionados a CNPJs coletivos — situação em que eventuais restrições aplicadas a um(a) integrante poderiam afetar toda a organização." ;
     bim:encontrado.em    "Apresentado pela organização / entidade produtora. Emitida através do Sistema de Certidões da Controladoria-Geral da União (CGU)"  .

bim:Indicador.SMT.11  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.11" ;
     bim:indicador    "Licença Ambiental válida, quando exigível" ;
     bim:descrição    "A organização cujos empreendimentos ou atividades sujeitas a licenciamento ambiental forem submetidas à TSB devem apresentar, em cada fase do licenciamento, as licenças ambientais cabíveis e válidas, nos termos da lei, para todos os estabelecimentos" ;
     bim:encontrado.em    "Apresentada pela organização / entidade produtora. Caso o Ibama seja o órgão competente, a licença pode ser consultada online. Nos estados, a disponibilidade da consulta online pode variar, porém a organização sempre poderá apresentar uma cópia da(s) licença(s)"  .

bim:Indicador.SMT.12  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.12" ;
     bim:indicador    "Ausência de Embargos dos órgãos ambientais federais e estaduais" ;
     bim:descrição    "A organização não poderá constar em bases de dados do Ibama, ICMBio ou órgão ambientais estaduais como tendo suas atividades embargadas. Quando a informação não estiver disponível online, certidões podem ser solicitadas aos órgãos ambientais. A relação dos órgãos ambientais estaduais que disponibilizam essas informações online pode ser consultada no estudo SIS (2024). Quando a informação não estiver disponível online, as certidões poderão ser solicitadas aos órgãos ambientais. Caso não haja resposta dentro do prazo legal máximo, a ausência de informação poderá ser admitida como justificada, desde que haja comprovação do envio formal da solicitação ao órgão competente" ;
     bim:encontrado.em    "Consulta por CPF/CNPJ nas Plataformas do Ibama , ICMBio ou dos órgãos ambientais do estado específico de interesse (quando houver)"  .

bim:Indicador.SMT.13  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.13" ;
     bim:indicador    "Ausência de Autuações Ambientais nos últimos cinco anos dos órgãos ambientais federais e estaduais" ;
     bim:descrição    "A organização não poderá ter praticado autuações ambientais relevantes nos últimos cinco anos, devendo essa análise considerar o estágio em que se encontra o processo administrativo punitivo, as possíveis penalidades a serem aplicadas, as alegações da organização e o fato de ela ser ou não reincidente. A relação dos órgãos ambientais estaduais que disponibilizam essas/ informações online pode ser consultada no estudo SIS (2024). Quando a informação não es ver disponível online, as certidões poderão ser solicitadas aos órgãos ambientais. Caso não haja resposta dentro do prazo legal máximo, a ausência de informação poderá ser admitida como justificada, desde que haja comprovação do envio formal da solicitação ao órgão competente" ;
     bim:encontrado.em    "Consulta por CPF/CNPJ nas Plataformas do Ibama , ICMBio ou dos órgãos ambientais do estado específico de interesse (quando houver)"  .

bim:Indicador.SMT.14  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Humanos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.14" ;
     bim:indicador    "Ausência nas Bases de dados do Ministério Público sobre inquéritos civis, Termos de Ajuste de Conduta (TACs), investigações criminais e ações civis públicas em caso de violações de direitos de natureza coletiva nos últimos cinco anos" ;
     bim:descrição    "A organização não poderá constar em bases do Ministério Público ( MP ) que registrem a existência de inquéritos civis, Termos de Ajustamento de Conduta ( TAC ), investigações criminais e ações civis públicas relacionadas a violações de direitos coletivos nos últimos cinco anos. Admite-se, excepcionalmente, o prazo de dois anos para o caso de povos indígenas, comunidades tradicionais e agricultores(as) familiares registrados(as) no Cadastro Nacional de Agricultura Familiar ( CAF ). No caso de TAC, deverá ser verificado junto à organização se está havendo o devido cumprimento das obrigações" ;
     bim:encontrado.em    "Verificação online nos sites do Ministério Público Federal, do Trabalho e Estadual ou mediante solicitações de certidões"  .

bim:Indicador.SMT.15  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.15" ;
     bim:indicador    "Ausência de Autuações Ambientais nos últimos cinco anos dos órgãos ambientais federais e estaduais" ;
     bim:descrição    "A organização cujas atividades estejam sujeitas ao registro no Cadastro Técnico Federal de Atividades Potencialmente Poluidoras ( CTF/APP ), nos termos da legislação ambiental vigente, deverá comprovar sua regularidade cadastral" ;
     bim:encontrado.em    "Apresentado pela organização / entidade produtora. Disponível através do portal do Ibama "  .

bim:Indicador.SMT.16  rdf:type  owl:NamedIndividual , bim:Indicador.Transversal ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMT.16" ;
     bim:indicador    "Ausência nas Bases de dados do Ministério Público sobre inquéritos civis, Termos de Ajuste de Conduta (TACs), investigações criminais e ações civis públicas em caso de violações de direitos de natureza coletiva nos últimos cinco anos" ;
     bim:descrição    "Quando identificado desmatamento, deverá ser apresentada a Autorização de Supressão de Vegetação ( ASV ) emitida pelo órgão ambiental competente, regularizando a remoção de vegetação nativa em áreas urbanas ou rurais, conforme o Código Florestal (Lei nº 12.651/2012)" ;
     bim:encontrado.em    "Emitida pelo órgão ambiental competente e apresentada pela organização. A identificação do desmatamento poderá ser realizada através do Programa de Monitoramento da Amazônia e outros Biomas por Satélite ( PRODES )"  .

bim:Indicador.SMA.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.1" ;
     bim:indicador    "Cadastro Ambiental Rural (CAR) ativo" ;
     bim:descrição    "O imóvel rural deve possuir CAR ativo. Não é admitido CAR cancelado ou suspenso" ;
     bim:encontrado.em    "Disponível através do Sistema Nacional de CAR ( Sicar )"  .

bim:Indicador.SMA.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Clima ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.2" ;
     bim:indicador    "Ausência de embargos por desmatamento do Ibama ou por órgão ambiental estadual" ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural em que exista embargo vigente por desmatamento ilegal, emitido por órgão ambiental competente, federal ou estadual, salvo quando o produtor rural comprovar a recuperação integral da área desmatada, conforme as exigências legais e ambientais vigentes" ;
     bim:encontrado.em    "A identificação do imóvel pode ser realizada na Plataforma do Ibama"  .

bim:Indicador.SMA.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Clima ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.3" ;
     bim:indicador    "Ausência de supressão ilegal de vegetação nativa, conforme legislação vigente e critérios" ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural no qual tenha ocorrido supressão ilegal de vegetação nativa, na forma definida pela Lei n°12.651/2012, salvo quando o(a) produtor(a) rural comprovar a regularização da área, conforme as exigências legais e ambientais vigentes.  A vedação não se aplica a imóveis rurais cuja supressão da vegetação nativa: a) Tenha sido inferior a cinco hectares (ha) em todo o período analisado b) Não esteja sob embargo vigente, conforme definido pela SMA.2. Caso tenha sido constatada supressão da vegetação na forma definida acima, o imóvel deverá apresentar um dos seguintes documentos que integrarão o dossiê da operação: a) Autorização de Supressão de Vegetação ( ASV ) ou Autorização para Uso Alternativo do Solo ( UAS ) relacionada à área desmatada, conforme art. 26 da Lei n°12.651/2012.  b) Documento que comprove que tenha executado ou esteja em execução o Projeto de Recuperação de Área Degradada ou Área Alterada ( PRAD ) ou Termo de Compromisso do Programa de Regularização Ambiental ( PRA ), aprovado pelo órgão ambiental competente. c) Termo de Ajustamento de Conduta ( TAC ) firmado com o Ministério Público para regularização ambiental ou d) Laudo Técnico de sensoriamento remoto, sob responsabilidade da instituição financeira, comprovando a ausência de desmatamento no imóvel rural após o período estabelecido" ;
     bim:encontrado.em    "A identificação do desmatamento poderá ser realizada através do Programa de Monitoramento da Amazônia e outros Biomas por Satélite ( PRODES )"  .

bim:Indicador.SMA.4  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Clima ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.4" ;
     bim:indicador    "Ausência de sobreposição com Unidades de Conservação ( UC ) que não admitam uso agrícola ou violação de regras de zonas de amortecimento de unidades de conservação" ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural situado total ou parcialmente em Unidade de Conservação ( UC ), desde que registrada no Cadastro Nacional de Unidades de Conservação ( CNUC ) e em desacordo com o Plano de Manejo da Unidade de Conservação, respeitadas as disposições do art. 28 da Lei nº9.985/2000, e as disposições específicas aplicáveis à população tradicional beneficiária ou residente, na forma do Decreto nº4.340/2002" ;
     bim:encontrado.em    "A verificação de eventual sobreposição é realizada via consultas constantes às bases de dados do CNUC do Ministério do Meio Ambiente e Mudança do Clima ( MMA )"  .

bim:Indicador.SMA.5  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.5" ;
     bim:indicador    "Ausência de sobreposição com Terras Indígenas declaradas, homologadas ou regularizadas" ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural situado total ou parcialmente em terras indígenas declaradas, conforme portaria do Ministério da Justiça e Segurança Pública, homologadas, regularizadas ou definidas como Reserva Indígena no Sistema Indigenista de Informações da Fundação Nacional dos Povos Indígenas ( FUNAI ), exceto nos casos em que o proponente pertença aos povos ou às comunidades indígenas ocupantes ou habitantes da terra indígena na qual se situa o empreendimento" ;
     bim:encontrado.em    "A verificação de eventual sobreposição é realizada via consulta ao site da FUNAI"  .

bim:Indicador.SMA.6  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.6" ;
     bim:indicador    "Ausência de sobreposição com Territórios Quilombolas já tituladas ou em processo de titulação com limites já identificados" ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural situado total ou parcialmente em terras ocupadas e tituladas por remanescentes das comunidades de quilombos, exceto os casos em que o proponente pertença ao grupo remanescente da comunidade do quilombo na qual se situa a área do empreendimento" ;
     bim:encontrado.em    "A verificação de eventual sobreposição é realizada via consulta à base de dados do Instituto Nacional de Colonização e Reforma Agrária ( Incra )"  .

bim:Indicador.SMA.7  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Clima ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.7" ;
     bim:indicador    "Ausência de sobreposição com Florestas Públicas Não Destinadas ( Tipo B )." ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural situado total ou parcialmente em Floresta Pública Tipo B (Não Destinada) registrada no Cadastro Nacional de Florestas Públicas ( CNFP ) do Serviço Florestal Brasileiro ( SFB ). Os critérios e eventuais exceções aplicáveis a essas áreas devem observar o disposto no Manual de Crédito Rural" ;
     bim:encontrado.em    "A verificação de eventual sobreposição é realizada via consulta à base de dados do Serviço Florestal Brasileiro"  .

bim:Indicador.SMA.8  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.8" ;
     bim:indicador    "Documento de Origem Florestal ( DOF ) do Ibama ou Guia Florestal." ;
     bim:descrição    "Obrigatório para o transporte e armazenamento de produtos florestais de origem nativa, incluindo carvão vegetal nativo. A exigência não se aplica ao cultivo de eucaliptos e outras espécies exóticas" ;
     bim:encontrado.em    "Apresentada pela organização. Emitido pelo Ibama ou órgão competente"  .

bim:Indicador.SMA.9  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.9" ;
     bim:indicador    "Outorga de Direito de Uso de Recursos Hídricos, quando aplicável à luz da legislação pertinente" ;
     bim:descrição    "Usuários de recursos hídricos devem apresentar outorgas que autorizem a captação e o lançamento de água, conforme definido por lei. A responsabilidade pela emissão dessas outorgas varia conforme a jurisdição do corpo hídrico. A Agência Nacional de Águas e Saneamento Básico ( ANA ) é responsável pelos corpos hídricos de domínio da União, ou seja, aqueles que atravessam mais de um estado ou fazem fronteira com outros países. Já os órgãos gestores de recursos hídricos estaduais são responsáveis pela emissão de outorgas para corpos hídricos localizados integralmente dentro dos limites de um estado" ;
     bim:encontrado.em    "Emitido pela ANA ou órgãos estaduais gestores de recursos hídricos e apresentada pela organização / entidade produtora"  .

bim:Indicador.SMA.10  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.10" ;
     bim:indicador    "Certificado de Qualidade em Biossegurança ( CQB ), quando aplicável" ;
     bim:descrição    "Entidades que realizam a vidades com organismos geneticamente modificados devem apresentar o Certificado de Qualidade em Biossegurança ( CQB ), emitido pela Comissão Técnica Nacional de Biossegurança ( CTNBio ), conforme legislação vigente" ;
     bim:encontrado.em    "Emitido pela CTNBio e apresentado pela organização / entidade produtora"  .

bim:Indicador.SMA.11  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.11" ;
     bim:indicador    "Comprovação do cumprimento de normas da vigilância sanitária" ;
     bim:descrição    "Licenças, registros oficiais e outros documentos que demonstrem o cumprimento das normas da vigilância sanitária" ;
     bim:encontrado.em    "Apresentada pela organização / entidade produtora"  .

bim:Indicador.SMA.12  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.12" ;
     bim:indicador    "Licença de Pescador e Pescadora Profissional válida" ;
     bim:descrição    "Licença de Pescador e Pescadora Profissional, seja Artesanal ou Industrial, emitida pelo Ministério da Pesca e Aquicultura ( MPA ), que autoriza a atividade de pesca profissional no Brasil, garan ndo que o pescador ou pescadora esteja regularizado/a para exercer a atividade conforme as normas ambientais e trabalhistas" ;
     bim:encontrado.em    "Emitido pelo MPA através do Sistema PesqBrasil e apresentado pela organização / entidade produtora"  .

bim:Indicador.SMA.13  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.13" ;
     bim:indicador    "Registro Geral da Atividade Pesqueira ( RGP ) e Permissão Prévia de Pesca ( PPP )." ;
     bim:descrição    "Obrigatório para todas as pessoas físicas e jurídicas que exerçam pesca profissional. Quando se tratar de embarcações de pesca extrativa, a Permissão Prévia de Pesca ( PPP ) também é necessária" ;
     bim:encontrado.em    "Emitido pelo MPA através do Sistema PesqBrasil e apresentado pela organização / entidade produtora"  .

bim:Indicador.SMA.14  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.14" ;
     bim:indicador    "Cadastro Nacional da Agricultura Familiar ( CAF ) quando aplicável" ;
     bim:descrição    "Para empreendimentos conduzidos por agricultores/as familiares, conforme definido pela Lei nº 11.326/2006, será exigida comprovação de inscrição regular no CAF como evidência de pertencimento ao segmento e de conformidade com critérios legais aplicáveis à agricultura familiar" ;
     bim:encontrado.em    "Emitido pelo Ministério do Desenvolvimento Agrário e Agricultura Familiar (MDA), via plataforma CAFWeb e apresentado pela organização / entidade produtora"  .

bim:Indicador.SMA.15  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.A ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMA.15" ;
     bim:indicador    "Autodeclaração de conformidade com critérios de uso de agrotóxicos" ;
     bim:descrição    "Não será considerado sustentável o financiamento para imóvel rural no qual tenham sido utilizados: a) nos cinco anos que antecedem o financiamento, agrotóxicos em desacordo com as Convenções de Estocolmo e Roterdã, ou classificados como 1A ou 1B pela Organização Mundial da Saúde ( OMS ), ou proibidos por outros acordos internacionais dos quais o Brasil seja signatário; b) a partir da vigência da TSB , agrotóxicos enquadrados nas classes toxicológicas 1, 2 e 3 pela Anvisa, e nas classes de Potencial de Periculosidade Ambiental (PPA) I e II pelo Ibama, exceto composições que comprovadamente não tenham alternativas técnicas e economicamente viáveis, a serem especificados no projeto técnico do financiamento; c) a partir de 1° de setembro de 2027, os agrotóxicos mencionados na alínea “b”, nos dois anos que antecedem o pedido de financiamento, exceto composições que comprovadamente não tenham alternativas técnicas e economicamente viáveis, a serem especificados no projeto técnico do financiamento" ;
     bim:encontrado.em    "Apresentada pela organização / entidade produtora. As classes toxicológicas e de PPA podem ser consultadas através de link"  .

bim:Indicador.SMB.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.1" ;
     bim:indicador    "Portaria de Autorização de Pesquisa e/ou Concessão de Lavra." ;
     bim:descrição    "A Portaria de Autorização de Pesquisa e/ou Concessão de Lavra é um documento emitido pela Agência Nacional de Mineração ( ANM ) que concede permissão para a realização de atividades de pesquisa mineral ou exploração de recursos minerais no Brasil, demonstrando conformidade com seus normativos, quando aplicável, nos casos em que o regime de autorização ou concessão regulatória exigir sua emissão. A Portaria só será exigida nos casos em que o regime de autorização ou concessão regulatória exigir sua emissão" ;
     bim:encontrado.em    "Emitida pela ANM e apresentada pela organização"  .

bim:Indicador.SMB.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.2" ;
     bim:indicador    "Anuência do Instituto Nacional de Colonização e Reforma Agrária ( Incra ), em áreas de projetos de assentamento da reforma agrária" ;
     bim:descrição    "A Instrução Normativa Incra nº 112/2021 estabelece que, nos casos de exploração minerária, incluindo atividades de pesquisa e lavra mineral, em áreas de projetos de assentamento da reforma agrária, será exigida a anuência prévia do Incra. A organização deverá requerer a anuência para o uso da área na unidade regional do Incra responsável pelo projeto de assentamento (art. 3º)" ;
     bim:encontrado.em    "Emitida pelo Incra e apresentada pela organização"  .

bim:Indicador.SMB.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.3" ;
     bim:indicador    "Cadastro Nacional de Barragens de Mineração ( CNBM )" ;
     bim:descrição    "Todas as empresas mineradoras que possuem barragens para disposição de rejeitos e sedimentos devem cadastrar suas estruturas no Cadastro Nacional de Barragens de Mineração (CNBM). Este cadastro é parte do Sistema Integrado de Gestão em Segurança de Barragens de Mineração. O objetivo principal é garantir a segurança das barragens utilizadas para contenção, acumulação ou disposição de rejeitos resultantes das atividades de mineração" ;
     bim:encontrado.em    "Emitido através do Sistema Integrado de Gestão em Segurança de Barragens de Mineração e apresentada pela organização"  .

bim:Indicador.SMB.4  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.4" ;
     bim:indicador    "Outorga de Direito de Uso de Recursos Hídricos, quando aplicável à luz da legislação pertinente" ;
     bim:descrição    "Usuários de recursos hídricos devem apresentar outorgas que autorizem a captação e o lançamento de água. A responsabilidade pela emissão dessas outorgas varia conforme a jurisdição do corpo hídrico. A Agência Nacional de Águas e Saneamento Básico ( ANA ) é responsável pelos corpos hídricos de domínio da União, ou seja, aqueles que atravessam mais de um Estado ou fazem fronteira com outros países. Já os órgãos gestores de recursos hídricos estaduais são responsáveis pela emissão de outorgas para corpos hídricos localizados integralmente dentro dos limites de um único Estado" ;
     bim:encontrado.em    "Emitida pela ANA ou órgãos estaduais gestores de recursos hídricos, e apresentada pela organização"  .

bim:Indicador.SMB.5  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.5" ;
     bim:indicador    "Plano de Segurança de Barragens ( PSB )" ;
     bim:descrição    "O Plano de Segurança da Barragem ( PSB ) reúne informações sobre a estrutura e a organização da barragem, constituindo se em um arquivo dinâmico que reúne toda a documentação referente à barragem em todas as fases de sua vida útil. Dessa forma, o PSB está em constante atualização, refletindo o acréscimo continuo de informações relevantes. Instrumento obrigatório somente para barragens enquadradas na Política Nacional de Segurança de Barragens (critérios indicados na Lei nº 12.334/2010)" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMB.6  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.6" ;
     bim:indicador    "Plano de Ação de Emergência ( PAE ), com Declaração atestando a sua Conformidade e Operacionalidade ( DCO )" ;
     bim:descrição    "O Plano de Ação de Emergência ( PAE ), que é parte do PSB , define os procedimentos a serem adotados em situações de emergência. Os Planos devem ser elaborados pelo responsável pela barragem e atualizado periodicamente, conforme a Política Nacional de Segurança de Barragens. Instrumento obrigatório somente para barragens enquadradas na Política Nacional de Segurança de Barragens (critérios indicados na Lei nº 12.334/2010)." ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMB.7  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.7" ;
     bim:indicador    "Plano de Recuperação de Áreas Degradadas ( PRAD ), quando exigível" ;
     bim:descrição    "Documentação comprobatória dos Planos de Recuperação de Áreas Degradadas ( PRAD )" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMB.8  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.8" ;
     bim:indicador    "Plano de Fechamento da Mina ( PFM ), quando exigível" ;
     bim:descrição    "Documentação comprobatória dos Planos de Fechamento de Mina ( PFM )" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMB.9  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.B ;
     bim:é.aplicado.em    bim:Diretriz.Tributária ;
     bim:tema    "Indicadores" ;
     bim:código    "SMB.9" ;
     bim:indicador    "Comprovação de regularidade de pagamento de Compensação Financeira por Exploração Mineral ( CFEM )" ;
     bim:descrição    "Relatório Anual de contas ou equivalente em conformidade com os dados de arrecadação da Compensação Financeira pela Exploração de Recursos Minerais ( CFEM ) disponibilizados pela Agência Nacional de Mineração ( ANM ). A CFEM é uma contrapar da pela exploração econômica dos recursos minerais" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMC.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMC.1" ;
     bim:indicador    "Certificado de Qualidade em Biossegurança ( CQB )." ;
     bim:descrição    "Organizações que realizam atividades com organismos geneticamente modificados devem apresentar o Certificado de Qualidade em Biossegurança ( CQB ), emitido pela Comissão Técnica Nacional de Biossegurança ( CTNBio ) conforme legislação vigente" ;
     bim:encontrado.em    "Emitido pela CTNBio e apresentado pela organização"  .

bim:Indicador.SMC.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMC.2" ;
     bim:indicador    "Outorga de Direito de Uso de Recursos Hídricos, quando aplicável à luz da legislação pertinente." ;
     bim:descrição    "Usuários de recursos hídricos devem apresentar outorgas que autorizem a captação e o lançamento de água. A responsabilidade pela emissão dessas outorgas varia conforme a jurisdição do corpo hídrico. A Agência Nacional de Águas e Saneamento Básico ( ANA ) é responsável pelos corpos hídricos de domínio da União, ou seja, aqueles que atravessam mais de um estado ou fazem fronteira com outros países. Já os órgãos gestores de recursos hídricos estaduais são responsáveis pela emissão de outorgas para corpos hídricos localizados integralmente dentro dos limites de um estado" ;
     bim:encontrado.em    "Emitida pela ANA ou órgãos estaduais gestores de recursos hídricos, e apresentado pela organização"  .

bim:Indicador.SMC.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.C ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:tema    "Indicadores" ;
     bim:código    "SMC.3" ;
     bim:indicador    "Comprovação do cumprimento de normas da vigilância sanitária." ;
     bim:descrição    "Apresentação de licenças, registros oficiais e outros documentos que demonstrem o cumprimento das normas da vigilância sanitária" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMD.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.D ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMD.1" ;
     bim:indicador    "Outorga de Direito de Uso de Recursos Hídricos, quando aplicável à luz da legislação pertinente." ;
     bim:descrição    "Usuários de recursos hídricos devem apresentar outorgas que autorizem a captação e o lançamento de água. A responsabilidade pela emissão dessas outorgas varia conforme a jurisdição do corpo hídrico. A Agência Nacional de Águas e Saneamento Básico ( ANA ) é responsável pelos corpos hídricos de domínio da União, ou seja, aqueles que atravessam mais de um estado ou fazem fronteira com outros países. Já os órgãos gestores de recursos hídricos estaduais são responsáveis pela emissão de outorgas para corpos hídricos localizados integralmente dentro dos limites de um único estado" ;
     bim:encontrado.em    "Emitida pela ANA ou órgãos estaduais gestores de recursos hídricos, e apresentada pela organização"  .

bim:Indicador.SMD.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.D ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:é.aplicado.em    bim:Diretriz.Povos ;
     bim:tema    "Indicadores" ;
     bim:código    "SMD.2" ;
     bim:indicador    "Outorga de Concessão ou Autorização para Geração de Energia Elétrica, quando aplicável ." ;
     bim:descrição    "Outorga de concessão ou autorização para Geração de Energia Elétrica, aplicável a centrais geradoras de energia elétrica. Conforme Resoluções vigentes da Agência Nacional de Energia Elétrica ( Aneel ) e portarias específicas do Ministério de Minas e Energia ( MME )" ;
     bim:encontrado.em    "Emitida pela Aneel ou MME, e apresentada pela organização"  .

bim:Indicador.SMD.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.D ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMD.3" ;
     bim:indicador    "Autorização para Produção de Hidrogênio de Baixa Emissão de Carbono, quando aplicável ." ;
     bim:descrição    "Para o exercício da a vidade de produção de hidrogênio de baixa emissão de carbono e seus derivados (relacionada a CNAE 2014-2/00) deverá ser apresentada autorização emitida pela Agência Nacional do Petróleo, Gás Natural e Biocombustiveis ( ANP ), conforme Política Nacional do Hidrogênio de Baixa Emissão de Carbono (Lei nº14.948/2024)" ;
     bim:encontrado.em    "Emitida pela ANP e apresentada pela organização"  .

bim:Indicador.SME.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SME.1" ;
     bim:indicador    "Outorga de Direito de Uso de Recursos Hídricos, quando aplicável à luz da legislação pertinente." ;
     bim:descrição    "Usuários de recursos hídricos devem apresentar outorgas que autorizem a captação e o lançamento de água. A responsabilidade pela emissão dessas outorgas varia conforme a jurisdição do corpo hídrico. A Agência Nacional de Águas e Saneamento Básico (ANA) é responsável pelos corpos hídricos de domínio da União, ou seja, aqueles que atravessam mais de um estado ou fazem fronteira com outros países. Já os órgãos gestores de recursos hídricos estaduais são responsáveis pela emissão de outorgas para corpos hídricos localizados integralmente dentro dos limites de um único estado" ;
     bim:encontrado.em    "Emitida pela ANA ou órgãos estaduais gestores de recursos hídricos, e apresentada pela organização"  .

bim:Indicador.SME.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SME.2" ;
     bim:indicador    "Autorização para Uso Alternativo do Solo ( UAS ), quando aplicável." ;
     bim:descrição    "Documento emitido pelo órgão ambiental competente que permite a alteração do uso do solo em áreas de vegetação na va para outras finalidades, como agricultura, pecuária ou construção civil. Essa autorização é necessária para garan r que a mudança no uso do solo seja feita de maneira sustentável e em conformidade com a legislação ambiental" ;
     bim:encontrado.em    "Emitida pelo órgão ambiental competente, e apresentada pela organização"  .

bim:Indicador.SME.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SME.3" ;
     bim:indicador    "Autodeclaração de conformidade com os Planos de Saneamento Básico (municipal, estadual ou regional) e as Normas de Referência da ANA." ;
     bim:descrição    "Organizações responsáveis pela prestação de serviços de saneamento básico devem apresentar uma declaração de sua conformidade com os Planos de Saneamento Básico em diferentes níveis de gestão: municipal, estadual ou regional, bem como o  atendimento das Normas de Referência publicadas pela Agência Nacional de Águas e Saneamento Básico (ANA)" ;
     bim:encontrado.em    "Apresentada pela organização responsável pela prestação dos serviços de saneamento básico. A conformidade com os Planos de Saneamento Básico (municipal, estadual ou regional) poderão ser verificadas junto à entidade reguladora infranacional pertinente"  .

bim:Indicador.SME.4  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.E ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SME.4" ;
     bim:indicador    "Autodeclaração de conformidade com os Planos de Gestão de Resíduos Sólidos (municipal, estadual ou regional) e as Normas de Referência da ANA." ;
     bim:descrição    "Organizações que gerem, transportem, armazenem, tratem ou destinem resíduos sólidos urbanos devem apresentar uma declaração de sua conformidade com os Planos de Gestão de Resíduos Sólidos em diferentes níveis de gestão: municipal, estadual ou regional, e as Normas de Referência da Agência Nacional de Águas e Saneamento Básico (ANA)." ;
     bim:encontrado.em    "Apresentada pela organização responsável pela prestação do serviço de manejo de resíduos sólidos urbanos"  .

bim:Indicador.SMF.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Area.Temática.07 ;
     bim:tema    "Indicadores" ;
     bim:código    "SMF.1" ;
     bim:indicador    "Autorização para Uso Alternativo do Solo ( UAS ), quando aplicável" ;
     bim:descrição    "Documento emitido pelo órgão ambiental competente que permite a alteração do uso do solo em áreas de vegetação nativa para outras finalidades, como agricultura, pecuária ou construção civil. Essa autorização é necessária para garantir que a mudança no uso do solo seja feita de maneira sustentável e em conformidade com a legislação ambiental" ;
     bim:encontrado.em    "Emitida pelo órgão ambiental competente, e apresentada pela organização"  .

bim:Indicador.SMF.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:é.aplicado.em    bim:Area.Temática.06 ;
     bim:tema    "Indicadores" ;
     bim:código    "SMF.2" ;
     bim:indicador    "Plano de Gerenciamento de Resíduos da Construção Civil ( PGRCC )" ;
     bim:descrição    "Documento que detalha todas as ações necessárias para o manejo adequado dos resíduos de construção e demolição, incluindo a não geração, a minimização, a reutilização, a reciclagem, o armazenamento, o transporte, o transbordo, o tratamento e a destinação final adequada dos resíduos por empreendimento, conforme legislação vigente" ;
     bim:encontrado.em    "Elaborado pelo grande gerador e aprovado pelo órgão competente"  .

bim:Indicador.SMF.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.F ;
     bim:é.aplicado.em    bim:Diretriz.Igualdade ;
     bim:é.aplicado.em    bim:Area.Temática.03 ;
     bim:tema    "Indicadores" ;
     bim:código    "SMF.3" ;
     bim:indicador    "Declaração de Acessibilidade na Anotação de Responsabilidade Técnica ( ART ) ou no Registro de Responsabilidade Técnica ( RRT ), quando aplicável" ;
     bim:descrição    "A declaração inserida na Anotação de Responsabilidade Técnica ( ART ) ou no Registro de Responsabilidade Técnica ( RRT ) certifica que o projeto ou obra de uso público ou coletivo cumpre os requisitos de acessibilidade definidos pela Lei Brasileira de Inclusão da Pessoa com Deficiência (Lei nº 13.146/2015), que estabelecem critérios para garantir o acesso, circulação e uso adequado de edificações por todas as pessoas, incluindo aquelas com deficiência ou mobilidade reduzida" ;
     bim:encontrado.em    "Emitida por profissional habilitado(a) e registrado(a) no respectivo conselho de classe, e apresentada pela organização"  .

bim:Indicador.SMH.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.1" ;
     bim:indicador    "Plano de Gerenciamento de Risco ( PGR ) e Plano de Ação de Emergência ( PAE ) para o transporte de produtos perigosos" ;
     bim:descrição    "O Plano de Gerenciamento de Risco ( PGR ) e o Plano de Ação de Emergência ( PAE ) são documentos técnicos que devem ser elaborados para empresas que realizem o transporte de produtos perigosos. O PAE/PGR deverão ser elaborados considerando as normas Agência Nacional de Transportes Terrestres ( ANTT ), Departamento Nacional de Infraestrutura de Transportes ( DNIT ), Associação Brasileira de Normas Técnicas ( ABNT ) e demais norma vos vigentes, além das orientações dos órgãos ambientais federais, estaduais e municipais com jurisdição sobre o trecho concedido" ;
     bim:encontrado.em    "Elaborados pela organização"  .

bim:Indicador.SMH.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.2" ;
     bim:indicador    "Termos de Autorização ( TAR ) para Navegação" ;
     bim:descrição    "Empresas de navegação devem apresentar o Termo de Autorização ( TAR ) para operar como empresa brasleira de navegação (Resolução Agência Nacional de Transportes Aquaviários ( ANTAQ ) nº 5/2016) e o TAR para explorar serviços de transporte na navegação interior (Resoluções ANTAQ n°912/2007 , 1.274/2009 , 1.558/2009)" ;
     bim:encontrado.em    "Emitidos pela ANTAQ e apresentados pela organização"  .

bim:Indicador.SMH.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Trabalhistas ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.3" ;
     bim:indicador    "Registro Nacional do Transportador Rodoviário de Cargas ( RNTRC )" ;
     bim:descrição    "Instituído pela Lei nº 10.233/2001, a inscrição no Registro Nacional do Transportador Rodoviário de Cargas ( RNTRC ) é obrigatória para os transportadores rodoviários remunerados de cargas, conforme a Agência Nacional de Transportes Terrestres ( ANTT )" ;
     bim:encontrado.em    "Emitido pela ANTT e apresentado pela organização"  .

bim:Indicador.SMH.4  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.4" ;
     bim:indicador    "Cadastro na Lista de Empresas Aéreas em Operação, segundo regulamentos da Agência Nacional de Aviação Civil ( Anac )" ;
     bim:descrição    "Todas as empresas aéreas, certificadas conforme regulamentos da Agência Nacional de Aviação Civil ( Anac ) – RBAC 91, 121, 129 ou 135, constam neste banco de dados, o que indica o cumprimento dos requisitos de certificação para operação" ;
     bim:encontrado.em    "Disponível no site da Anac "  .

bim:Indicador.SMH.5  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Clima ;
     bim:é.aplicado.em    bim:Diretriz.Poluição ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.5" ;
     bim:indicador    "Comprovação de adesão ao Nível I do Programa da Sustentabilidade da ANTT para rodovias e ferrovias." ;
     bim:descrição    "Alinhamento das concessionárias de infraestrutura rodoviária e ferroviária ao Nível I do Programa de Sustentabilidade para Infraestrutura de Rodovias e Ferrovias Reguladas pela Agência Nacional de Transportes Terrestres (ANTT), conforme Resolução ANTT 6.057/2024. O programa está estruturado em três níveis de adesão, sendo o Nível I o ponto de entrada. A empresa deverá comprovar a adesão, ao menos, ao Nível I do Programa" ;
     bim:encontrado.em    "Apresentada pela organização"  .

bim:Indicador.SMH.6  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.6" ;
     bim:indicador    "Termo de Autorização ( TAR )" ;
     bim:descrição    "Com relação ao transporte rodoviário cole vo interestadual de passageiros, sob o regime de autorização, o documento necessário para a transportadora é o Termo de Autorização (TAR), em conformidade com a Resolução nº 6.033/2023. Com relação ao transporte rodoviário cole vo interestadual e internacional de passageiros realizado em regime de fretamento, sob o regime de autorização, o documento necessário para a transportadora é o Termo de Autorização, em conformidade com a Resolução ANTT nº 4.777/2015. As empresas deverão comprovar que tem um termo de autorização vigente" ;
     bim:encontrado.em    "Emitido pela ANTT e apresentado pela organização"  .

bim:Indicador.SMH.7  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.7" ;
     bim:indicador    "Termo de Autorização / Contrato de Concessão para o transporte ferroviário de passageiros" ;
     bim:descrição    "Com relação ao transporte ferroviário de passageiros, sob o regime de autorização que inclui a exploração da infraestrutura, autorização da transportadora se dá nos termos da Resolução nº 5.987/2022. Com relação ao transporte ferroviário de passageiros não regular e eventual, com finalidade turís ca, histórico-cultural e comemora va, a autorização da transportadora se dá nos termos da Resolução nº 5.974/2022 (Capítulo II). Com relação ao transporte ferroviário de passageiros realizado sob regime de concessão, o serviço se dá nos termos do respec vo Contrato de Concessão. A empresa deverá comprovar que possui a documentação necessária para operação" ;
     bim:encontrado.em    "Emitido pela ANTT e apresentado pela organização"  .

bim:Indicador.SMH.8  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.8" ;
     bim:indicador    "Contrato de Permissão ou Autorização Especial para o transporte rodoviário de passageiros semiurbano" ;
     bim:descrição    "Com relação ao transporte rodoviário de passageiros semiurbano, a delegação do serviço pode se dar por meio de Permissão - via processo licitatório -, ou por meio de Autorização Especial, ambas em conformidade com a Lei nº 10.233/2001. No primeiro caso, a transportadora deve comprovar que possui um Contrato de Permissão vigente. No segundo caso, a transportadora deve comprovar que possui Autorização Especial, nos termos da Resolução nº 2.869/2008, ou resolução específica que a tenha criado" ;
     bim:encontrado.em    "Emitido pela ANTT e apresentado pela organização"  .

bim:Indicador.SMH.9  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.H ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMH.9" ;
     bim:indicador    "Contrato de Parceria para prestação de serviços públicos de transporte urbano" ;
     bim:descrição    "Os casos que envolvam a prestação de serviços públicos de transporte urbano e não sejam operados diretamente pelo poder público, incluindo empresas públicas e sociedades de economia mista, deverão possuir contrato de parceria, conforme a definição do § 2º do art. 1º da Lei nº 13.334/2016. A empresa deverá comprovar que tem um contrato de parceria (na modalidade que seja) vigente com a autoridade pública" ;
     bim:encontrado.em    "Emitido pela autoridade reguladora e apresentado pela organização"  .

bim:Indicador.SMTur.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.Tur ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTur.1" ;
     bim:indicador    "Comprovação de Cadastro de Prestadores de Serviços Turísticos ( Cadastur ) ativo" ;
     bim:descrição    "Permite ao prestador de serviços turís cos (pessoa física ou jurídica) atuar em conformidade com a Lei Geral do Turismo, por meio da emissão do Certificado do Cadastro de Prestadores de Serviços Turísticos ( Cadastur )" ;
     bim:encontrado.em    "Apresentada pela organização. Sua autenticidade pode ser constatada no link ou mediante verificação do Código QR. O MTur divulga os dados dos prestadores cadastrados na base do Cadastur no Portal de Dados Abertos do Governo Federal"  .

bim:Indicador.SMTur.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.Tur ;
     bim:é.aplicado.em    bim:Diretriz.Igualdade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTur.2" ;
     bim:indicador    "Laudo de acessibilidade conforme NBR 9050 com ART / RRT registrada, quando aplicável" ;
     bim:descrição    "Documento técnico que atesta se um empreendimento que busca alinhamento à TSB está em conformidade com os princípios de acessibilidade universal, conforme definidos pela norma NBR 9050 da ABNT. O laudo é obrigatório para organizações responsáveis por edificações e espaços de uso coletivo e deve ser protocolado junto ao conselho regional responsável — Conselho Regional de Engenharia e Agronomia ( CREA ) ou Conselho de Arquitetura e Urbanismo ( CAU ) — do estado onde está localizado o empreendimento). O laudo deve ser elaborado e assinado por um ou uma profissional legalmente habilitado, que registrará a devida Anotação de Responsabilidade Técnica (ART) ou Registro de Responsabilidade Técnica (RRT)" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMTur.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.Tur ;
     bim:é.aplicado.em    bim:Diretriz.Ecossistema ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTur.3" ;
     bim:indicador    "Anuência formal do Instituto do Patrimônio Histórico e Artístico Nacional ( Iphan ) para projetos em áreas tombadas ou em seu entorno" ;
     bim:descrição    "Anuência do Instituto do Patrimônio Histórico e Artísco Nacional ( Iphan ) para intervenções em áreas tombadas ou no entorno de bens protegidos pela autarquia" ;
     bim:encontrado.em    "Documento emitido pela Iphan e apresentado pela organização"  .

bim:Indicador.SMTur.4  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.Tur ;
     bim:é.aplicado.em    bim:Diretriz.Direitos.Humanos ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTur.4" ;
     bim:indicador    "Comprovação de adesão ao Código de Conduta Brasil" ;
     bim:descrição    "Comprovação de adesão ao Código de Conduta Brasil por meio do Selo identificador. A adesão ao Código, apesar de voluntária, expressa um compromisso na prevenção e no enfrentamento à exploração sexual  de crianças e adolescentes no setor de turismo" ;
     bim:encontrado.em    "A adesão ao Código é realizada através do site do Código de Conduta Brasil, onde é possível gerar o Selo iden ficador. O Selo deverá ser apresentado pela organização."  .

bim:Indicador.SMTIC.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Diretriz.Igualdade ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTIC.1" ;
     bim:indicador    "Relatório de Impacto Algorítmico (RIA) publicado, quando aplicável" ;
     bim:descrição    "Demonstra que a organização adota medidas para mitigação de vieses algorítmicos e inclusão ética nos sistemas utilizados, quando aplicável" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMTIC.2  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Diretriz.Clima ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTIC.2" ;
     bim:indicador    "Registro no Sistema Eletrônico de Informações Ambientais (Sisnama) para uso de refrigerantes, quando aplicável" ;
     bim:descrição    "O Sistema Eletrônico de Informações Ambientais (Sisama), por meio de órgãos estaduais ou do Ibama, exige, em alguns casos, o registro do uso de gases refrigerantes e substâncias controladas, conforme regulamentações específicas. O critério pode não ser aplicável a pequenos prestadores de serviços de telecomunicações" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMTIC.3  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.TIC ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMTIC.3" ;
     bim:indicador    "Registro do Relatório de Impacto à Proteção de Dados (RIPD) e do controlador na Autoridade Nacional de Proteção de Dados (ANPD)" ;
     bim:descrição    "Comprova o cumprimento da Lei Geral de Proteção de Dados Pessoais ( LGPD ), aplicável a organizações que realizam operações de tratamento de dados pessoais em larga escala, conforme exigido pela regulamentação vigente" ;
     bim:encontrado.em    "Apresentado pela organização"  .

bim:Indicador.SMPU.1  rdf:type  owl:NamedIndividual , bim:Indicador.Setorial ;
     bim:é.dentro.de    bim:Caderno.S.Mínimas ;
     bim:é.aplicado.em    bim:Setor.TSB.PU ;
     bim:é.aplicado.em    bim:Diretriz.Integridade ;
     bim:tema    "Indicadores" ;
     bim:código    "SMPU.1" ;
     bim:indicador    "Licenciamento urbanístico ou edilício do empreendimento, quando aplicável" ;
     bim:descrição    "Atesta que a execução de obras e a vidades alinhadas à TSB em determinado espaço urbano está em conformidade com as leis e normas de planejamento urbano estabelecidas pelo município. A comprovação pode ser feita por meio de parecer técnico ou aprovação formal do órgão municipal competente" ;
     bim:encontrado.em    "Apresentado pela organização"  .

