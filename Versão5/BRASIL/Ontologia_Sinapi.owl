ObjectProperty: bim:p.analisar
	SubPropertyOf: bim:BIMProp



ObjectProperty: bim:é.eap
	SubPropertyOf: bim:p.analisar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a analisar: é.eap"@pt
	Annotations: bim:Chave "d.analisar.116"
	Annotations: bim:Ação "Ação de analisar"@pt
	Annotations: bim:Definição "Declara a estrutura analítica do projeto para fins de orçamentação do projeto. Estabelece  métodos de construção, tarefas, critérios de verificação e controle qualidade."@pt
	Annotations: bim:Definición "Declara la estructura de desglose del trabajo para fines de presupuestación del proyecto. Establece métodos de construcción, tareas, criterios de verificación y control de calidad."@es
	Annotations: bim:Definition "Declares the work breakdown structure for the purpose of project budgeting. It establishes construction methods, tasks, verification criteria and quality control."@en
	EquivalentTo: bim:é.estudo.analítico.do.projeto

