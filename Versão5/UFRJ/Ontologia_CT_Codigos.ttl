      rdfs:subClassOf  bim:Tanques ;
      rdfs:label  "Tanque de Expansão"@pt ;
      bim:Definição   "Tanque em sistemas hidráulicos e térmicos fechados. Projetado para absorver variações de volume do fluido causadas por mudanças de temperatura. Ele protege o sistema contra sobrecarga de pressão, evitando danos a tubulações, válvulas e equipamentos."@pt ;
      bim:Definición  "Depósito en sistemas hidráulicos y térmicos cerrados. Diseñado para absorber las variaciones de volumen de fluido causadas por los cambios de temperatura. Protege el sistema de sobrecargas de presión, evitando daños a tuberías, válvulas y equipos."@es ;
      bim:Definition  "Tank in closed hydraulic and thermal systems. Designed to absorb fluid volume variations caused by temperature changes. It protects the system from pressure overload, preventing damage to pipes, valves, and equipment."@en ;
      bim:Natureza    "Insumos"@pt ;
      bim:Espécie     "Insumo Armazenamento"@pt ;
      bim:Tema        "Tanques"@pt ;
      bim:Disciplina  "Arquitetura"@pt ;
      bim:Chave       "Key-COD-772"@pt ;
      bim:CatRevit    "[ OST_FabricationContainment : OST_SpecialityEquipment  ]"   ;
