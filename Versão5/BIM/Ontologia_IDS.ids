		<!-- "Indice de TTRF resistência ao Fogo." -->
		<specification name="Req_Inc_01" ifcVersion="IFC4" identifier="Req_Inc_01" description="Indice de TTRF resistência ao Fogo.">
			<applicability minOccurs= "1" maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCWALL</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-0P</simpleValue></system>
					<value><simpleValue>0P.60.60.03</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attribute  cardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<value><simpleValue>Parede 10cm</simpleValue></value>
				</attribute>
				<property  dataType="IFCLABEL"  cardinality="required">
					<propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
					<baseName><simpleValue>FireRating</simpleValue></baseName>
				<value>
					<xs:restriction base="xs:string">
						<xs:enumeration value="30 min"/>
						<xs:enumeration value="60 min"/>
						<xs:enumeration value="90 min"/>
						<xs:enumeration value="120 min"/>
					</xs:restriction>
				</value>
				</property>
			</requirements>
		</specification>

