bim:Certificação.ABNT  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "ABNT NBR 15401: Norma Brasileira de ABNT que estabelece requisitos para um Sistema de Gestão da Sustentabilidade em Meios de Hospedagem."  .

bim:Certificação.AQUA  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de construção" ;
     bim:descrição    "Alta Qualidade Ambiental (AQUA): certificação para construções sustentáveis, com metodologia adaptada ao contexto e às regulamentações brasileiras."   .

bim:Certificação.Blue  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "Bandeira Azul (Blue Flag): certificação internacional de renome para praias, marinas e operadores de turismo náutico sustentável. Foca em critérios rigorosos relacionados à educação ambiental e informação, qualidade da água balneável, gestão ambiental, segurança e serviços, sendo um símbolo global de excelência em sustentabilidade e qualidade ambiental."  .

bim:Certificação.Biosphere  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "Biosphere Tourism: certificação internacional para destinos e empresas turísticas, baseada nos Objetivos de Desenvolvimento Sustentável (ODS) da ONU e no Acordo de Paris, com foco em gestão sustentável, desenvolvimento social e econômico, conservação cultural e ambiental."  .

bim:Certificação.EarthCheck  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "EarthCheck: uma das principais certificações científicas e programas de benchmarking para a indústria de viagens e turismo."  .

bim:Certificação.Orgânico  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de produtos orgânicos" ;
     bim:descrição    "Ecocert Brasil (Orgânico): uma das principais certificadoras de produtos orgânicos no Brasil, oferecendo selos que atestam a conformidade com as normas orgânicas nacionais e internacionais."  .

bim:Certificação.Madeira  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação florestal" ;
     bim:descrição    "Forest Stewardship Council (FSC): certificação para produtos florestais (madeira e papel) que são manejados de forma responsável, aplicável a materiais de construção ou produtos consumidos no setor."  .

bim:Certificação.GreenD  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "Green Destinations: programa de certificação global e acreditado pelo Global Sustainable Tourism Council (GSTC) para destinos turísticos que buscam e demonstram compromisso com a sustentabilidade, com foco em gestão integrada, proteção da natureza e paisagem, e bem estar da comunidade local."  .

bim:Certificação.GreenK  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "Green Key: um eco-selo internacional líder para instalações turísticas (hotéis, pousadas, campings, restaurantes, atrações etc.), reconhecido por padrões de responsabilidade ambiental e operação sustentável."  .

bim:Certificação.LEED  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de edifícios verdes" ;
     bim:descrição    "Leadership in Energy and Environmental Design (LEED): um dos sistemas de classificação de edifícios verdes mais amplamente utilizados no mundo, aplicável a construções e reformas de infraestruturas turísticas."  .

bim:Certificação.PEFC  rdf:type  owl:NamedIndividual , bim:Certificação ;
