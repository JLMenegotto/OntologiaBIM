ObjectProperty: bim:é.esg.ambiental.descarbonização
	SubPropertyOf: bim:p.priorizar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a priorizar: é.esg.ambiental.descarbonização"@pt
	Annotations: bim:Chave "d.priorizar.104"
	Annotations: bim:Ação "Ação de priorizar"@pt
	Annotations: bim:Definição "Declara que a ação ESG é no pilar ambiental: descarbonização reduzindo emissões de CO₂, metas de neutralidade climática, eficiência energética."@pt
	Annotations: bim:Definición "Declara que la acción ESG está en el pilar medioambiental: descarbonización mediante la reducción de emisiones de CO₂, objetivos de neutralidad climática, eficiencia energética."@es
	Annotations: bim:Definition "Declares that ESG action is in the environmental pillar: decarbonization by reducing CO₂ emissions, climate neutrality goals, energy efficiency."@en
	EquivalentTo: bim:é.ods.07

