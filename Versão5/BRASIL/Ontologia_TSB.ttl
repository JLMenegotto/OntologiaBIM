     bim:é.certificado.por    bim:Certificação.GreenK ;
     bim:é.certificado.por    bim:Certificação.LEED ;
     bim:é.certificado.por    bim:Certificação.PEFC ;
     bim:é.certificado.por    bim:Certificação.RAC ;
