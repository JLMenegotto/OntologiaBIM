	SubPropertyOf: bim:p.objetivar
	domain: bim:BIM
	Annotations: rdfs:label "Propriedade destinada a objetivar: é.ods.01"@pt
	Annotations: bim:Chave "d.objetivar.100"
	Annotations: bim:Ação "Ação de objetivar"@pt
	Annotations: bim:Definição "Declara que objetiva o ODS para Erradicação da Pobreza."@pt
	Annotations: bim:Definición "Declara que su objetivo es el ODS para la Erradicación de la Pobreza."@es
	Annotations: bim:Definition "Declares that it aims at the SDG for the Eradication of Poverty."@en
	EquivalentTo: bim:é.missão.principal

DataProperty: bim:d.objetivar
	SubPropertyOf: bim:BIMData



DataProperty: bim:ods.01
	SubPropertyOf: bim:d.objetivar
