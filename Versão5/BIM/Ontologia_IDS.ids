	<specifications> 

		<!-- "Área mínima de quartos." -->
		<specification name="Req_Amb_01" ifcVersion="IFC4" identifier="Req_Amb_01" description="Área mínima de quartos.">
			<applicability  minOccurs= "1"  maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.01.01</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attribute  cardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<value><simpleValue>Quarto.*</simpleValue></value>
				</attribute>
				<property  dataType="IFCAREAMEASURE"   cardinality="required">
					<propertySet><simpleValue>Pset_SpaceCommon</simpleValue></propertySet>
					<baseName><simpleValue>NetFloorArea</simpleValue></baseName>
					<value>
						<xs:restriction base="xs:double">
							<xs:minInclusive value="10"/>
						</xs:restriction>
					</value>
				</property>
			</requirements>
		</specification>

		<!-- "Área mínima de salas." -->
		<specification name="Req_Amb_02" ifcVersion="IFC4" identifier="Req_Amb_02" description="Área mínima de salas.">
			<applicability  minOccurs= "1"  maxOccurs= "unbounded">
				<entity>
					<name><simpleValue>IFCSPACE</simpleValue></name>
				</entity>
				<classification>
					<system><simpleValue>NBR-15965-4A</simpleValue></system>
					<value><simpleValue>4A.19.01.07</simpleValue></value>
				</classification>
			</applicability>
			<requirements>
				<attribute  cardinality="required">
					<name><simpleValue>Name</simpleValue></name>
					<value><simpleValue>Sala</simpleValue></value>
				</attribute>
				<property  dataType="IFCAREAMEASURE"   cardinality="required">
					<propertySet><simpleValue>Pset_SpaceCommon</simpleValue></propertySet>
					<baseName><simpleValue>NetFloorArea</simpleValue></baseName>
					<value>
						<xs:restriction base="xs:double">
							<xs:minInclusive value="30"/>
						</xs:restriction>
					</value>
				</property>
			</requirements>
		</specification>

