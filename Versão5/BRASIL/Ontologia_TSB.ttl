     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação florestal" ;
     bim:descrição    "Programme for the Endorsement of Forest Certification (PEFC): sistema de certificação global para o manejo florestal sustentável, complementando o FSC."  .

bim:Certificação.RAC  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de atividades de turismo" ;
     bim:descrição    "Rainforest Alliance Certified: selo que garante que empresas e produtos (incluindo alguns empreendimentos turísticos) foram produzidos seguindo práticas rigorosas de sustentabilidade ambiental, social e econômica, com foco na conservação da biodiversidade."  .

bim:Certificação.SISORG  rdf:type  owl:NamedIndividual , bim:Certificação ;
     bim:é.dentro.de    bim:Caderno.S.Sociais ;
     bim:é.certificação    bim:Certificados ;
     bim:é.explicado.em    bim:Nota.Conformidade ;
     bim:tema    "Certificação de produtos orgânicos" ;
     bim:descrição    "Selo Orgânico Brasil (Sistema Brasileiro de Avaliação da Conformidade Orgânica – SISORG): certificação oficial brasileira que garante que os produtos agrícolas (incluindo aqueles usados em serviços de alimentação turística) são produzidos sem agrotóxicos ou insumos químicos, seguindo práticas de produção orgânica."  .

